# loop-lore environment overrides
# Loaded after config.yaml — overrides config file values
# Env vars (process.env) still win over everything
# Rename to env.yaml to activate
# $schema: ./schemas/loop-lore-config.schema.json

# ── Minimal example — uncomment and set what you need ──

# server:
#   port: 3000

# db:
#   type: sqlite
#   sqliteFilename: ../loop-lore-data/loop-lore.db

# auth:
#   required: true
#   registrationOpen: false

