# Can be modified locally
.gitattributes

dist/
node_modules/

# Runtime data (stale in-project location — migrated to ../loop-lore-data/)
data/
# User runtime data directory (SQLite DB, uploads, etc.)
loop-lore-data/

# Pre-compressed static assets (generated on server start)
*.br
*.gz
*.zst

# Environment overrides (env.yaml replaces .env — supports nested/arrays/multiline)
env.yaml

# Runtime config files (user-specific, not committed)
config.yaml
config.yml
config.toml

# Per-developer config overrides (gitignored, merged on top of config.default.*)
config.local.yaml
config.local.yml
config.local.toml

# Per-backend config files — user-specific, contain paths/secrets/tokens
config.llama-swap.yaml
config.llama-cpp.yaml
config.sd-cpp.yaml
config.e2e.yaml

# Server launch scripts — user-specific paths, not committed
config.*.sh

# TODO Remove once confirmed AND agent-related paths
.opencode/
.hermes
.tmp
.omp/

# MCPs
.playwright-mcp/

# Git worktrees (parallel branch development)
tree/*

# Agent credentials (GPG keys, signing config — never commit)
.credentials.env

# Tooling output (reports, analysis, optimization)
.jscpd-report/
token-optimizer/
docs/meta/refactoring-analysis.md

# VitePress compiled output (generated from .mts)
docs/.vitepress/config.mjs
docs/.vitepress/cache/

# Auto-generated issue tracker (regenerate with docs:gen)
docs/meta/issues.md
