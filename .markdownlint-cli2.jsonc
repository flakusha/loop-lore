{
  // Skip generated plan artifacts. These are machine-generated by giwt
  // (plan links / feature matrix / epics index / plan-gen docs mirror) and
  // are not hand-maintained prose. Linting them dominated the md:lint gate
  // (~850s, ~8k files) -- interconnect.md alone is 5.9MB.
  //
  // `gitignore: true` additionally drops the gitignored docs/plan-gen/** mirror.
  "gitignore": true,
  "ignores": [
    ".plan/interconnect.md",
    ".plan/feature-matrix.md",
    ".plan/epics-index.md",
    "docs/plan-gen/**"
  ]
}
