# Agent GPG signing credentials for worktrees
# Copy this file to .credentials.env and fill in your values
# NEVER commit .credentials.env — it is gitignored

# Agent GPG key fingerprint (for commit signing)
AGENT_GPG_KEY_ID=""

# Agent committer identity (shown in git log as Committer)
AGENT_GPG_NAME="Your Name (Agent)"
AGENT_GPG_EMAIL="your-email@example.com"

# BYOK E2E (tests/e2e/flows/byok-kek.test.ts, tier 2 — real vendor call)
# Tier 1 (HTTP round-trip + KEK isolation on an ephemeral server) always runs
# with no credentials and no network. Tier 2 stores a real key through the
# HTTP API and runs one tiny generation against it, then deletes the key.
# Leave blank (or set BYOK_E2E_SKIP=1) to skip tier 2.
# Small/cheap model recommended — tier 2 sends one ≤20-token completion.
BYOK_E2E_API_KEY=""
BYOK_E2E_BASE_URL="https://openrouter.ai/api/v1"
BYOK_E2E_MODEL="openai/gpt-4o-mini"
# BYOK_E2E_SKIP=1

# Memory transport E2E (tests/e2e/flows/embed-rerank.test.ts)
# Tier 1 (fake-server wire + header checks) always runs. Live tier needs the
# shared OpenRouter key above plus OpenAI-compatible bases; models MUST stay
# :free — otherwise tier 2 spends real credits.
E2E_EMBED_MODEL="nvidia/nemotron-3.5-embed-1b:free"
EMBEDDINGS_API="openai"
EMBEDDINGS_BASE_URL="https://openrouter.ai/api/v1"
EMBEDDINGS_INPUT_TYPE="query"
E2E_RERANK_MODEL="nvidia/nemotron-3.5-rerank-8b:free"
E2E_RERANK_PROVIDER="openrouter"
RERANK_BASE_URL="https://openrouter.ai/api/v1"
# E2E_EMBEDDINGS_KEY=""   # optional surface key; else BYOK_E2E_API_KEY
# E2E_RERANK_KEY=""       # optional surface key; else BYOK_E2E_API_KEY

# TTS E2E (tests/e2e/flows/tts-fish.test.ts)
# Tier 1 (no-key failure closure) always runs. Live tier synthesizes one
# short sentence over the shared OpenRouter key; model MUST stay :free.
E2E_TTS_MODEL="fish-audio/s2.1-pro-free:free"
# E2E_TTS_VOICE=""   # optional voice id; provider default otherwise

# Decision E2E (tests/e2e/flows/decision-aux.test.ts)
# Skips without the shared key. Live tier runs the judge injection-check
# classifier over a :free chat model; model MUST stay :free.
E2E_DECISION_MODEL="google/gemma-4-26b-a4b-it:free"

# Translation E2E (tests/e2e/flows/translation-gemma.test.ts)
# Tier 1 (parser + local fallback) always runs. Live tier translates two
# short strings over the shared key; model MUST stay :free. Free
# shared-pool models 429 transiently — the adapter retries briefly.
E2E_TRANSLATE_MODEL="google/gemma-4-26b-a4b-it:free"

# Local llama-swap E2E (tests/e2e/flows/local-llama-swap.test.ts)
# Tier 1 (resolver defaults) always runs. Presence tier (fast /health +
# /running + /v1/models roster check) runs whenever the proxy answers and
# skips cleanly otherwise. The live completion leg is OPTIONAL behind
# E2E_LOCAL_LIVE=1: the first request loads the model into VRAM, so it is
# never part of the default run.
LLAMA_SWAP_BASE_URL="http://127.0.0.1:7180"
# E2E_LOCAL_CHAT_MODEL="llama-qwen3.5-llmfan-9b"   # smallest chat model; cheap load
# E2E_LOCAL_LIVE=""   # set to 1 to pay for one real local completion
