{
  "compilerOptions": {
    "lib": [
      "deno.window",
      "DOM",
      "ESNext"
    ],
    "strict": true
  },
  "imports": {
    "@alpinejs/morph": "npm:@alpinejs/morph@^3.16.1",
    "@biomejs/biome": "npm:@biomejs/biome@^2.5.8",
    "@elysia/openapi": "npm:@elysia/openapi@^1.4.15",
    "@eslint/js": "npm:@eslint/js@^10.0.1",
    "@markuplint/html-spec": "npm:@markuplint/html-spec@^4.18.0",
    "@markuplint/mustache-parser": "npm:@markuplint/mustache-parser@4.18.3",
    "@playwright/test": "npm:@playwright/test@^1.62.1",
    "@sinclair/typebox": "npm:@sinclair/typebox@^0.34.52",
    "@types/blessed": "npm:@types/blessed@^0.1.27",
    "@types/bun": "npm:@types/bun@^1.3.14",
    "@types/clean-css": "npm:@types/clean-css@^4.2.11",
    "@types/dompurify": "npm:@types/dompurify@^3.2.0",
    "@types/html-minifier-terser": "npm:@types/html-minifier-terser@^7.0.2",
    "@types/js-yaml": "npm:@types/js-yaml@^4.0.9",
    "@types/jszip": "npm:@types/jszip@^3.4.1",
    "@types/terser": "npm:@types/terser@^3.12.0",
    "alpinejs": "npm:alpinejs@^3.16.1",
    "blessed": "npm:blessed@^0.1.81",
    "blessed-contrib": "npm:blessed-contrib@^4.11.0",
    "bun-plugin-html": "npm:bun-plugin-html@2.2.8",
    "clean-css": "npm:clean-css@^5.3.3",
    "dompurify": "npm:dompurify@^3.4.13",
    "dprint": "npm:dprint@^0.55.2",
    "elysia": "npm:elysia@^1.4.29",
    "eslint": "npm:eslint@^10.8.1",
    "eslint-plugin-import": "npm:eslint-plugin-import@^2.32.0",
    "eslint-plugin-markdown": "npm:eslint-plugin-markdown@^5.1.0",
    "eslint-plugin-sonarjs": "npm:eslint-plugin-sonarjs@^4.2.0",
    "eslint-plugin-unicorn": "npm:eslint-plugin-unicorn@^73.0.0",
    "globals": "npm:globals@^17.11.0",
    "htmx-ext-alpine-morph": "npm:htmx-ext-alpine-morph@^2.0.2",
    "htmx-ext-sse": "npm:htmx-ext-sse@^2.2.4",
    "htmx.org": "npm:htmx.org@2.0.10",
    "js-yaml": "npm:js-yaml@^5.3.0",
    "jscpd": "npm:jscpd@^5.0.15",
    "jszip": "npm:jszip@^3.10.1",
    "knip": "npm:knip@^6.32.2",
    "kysely": "npm:kysely@^0.29.5",
    "markdownlint-cli2": "npm:markdownlint-cli2@^0.23.2",
    "marked": "npm:marked@^18.0.9",
    "markuplint": "npm:markuplint@^4.18.3",
    "obscenity": "npm:obscenity@^0.4.6",
    "smol-toml": "npm:smol-toml@^1.8.0",
    "stylelint": "npm:stylelint@^17.14.1",
    "stylelint-config-standard": "npm:stylelint-config-standard@^40.0.0",
    "type-coverage": "npm:type-coverage@^2.30.1",
    "typescript": "npm:typescript@^5.9.3",
    "typescript-eslint": "npm:typescript-eslint@^8.67.0",
    "vitepress": "npm:vitepress@^1.6.4"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "build": "deno task build:frontend && deno task build:server",
    "build:frontend": "deno run scripts/build-frontend.mjs",
    "build:server": "bun build src/server/index.ts --outdir ./dist --target bun",
    "check": "deno task check:parallel",
    "check:ci": "deno run scripts/check-parallel.mjs --ci",
    "check:fix": "deno run scripts/check-parallel.mjs --fix",
    "check:format": "deno task format:dprint && deno task md:lint",
    "check:full": "deno task build:frontend && deno task check",
    "check:lint": "deno task lint && deno task lint:css && deno task lint:html && deno task lint:html-scripts && deno task lint:chaining",
    "check:parallel": "deno run scripts/check-parallel.mjs",
    "check:serial": "deno task typecheck && deno task typecheck:frontend && deno task typecheck:coverage && deno task typecheck:coverage:frontend && deno task lint && deno task lint:css && deno task lint:html && deno task lint:html-scripts && deno task lint:chaining && deno task format:dprint && deno task md:lint",
    "check:typecheck": "deno task typecheck && deno task typecheck:frontend && deno task typecheck:coverage && deno task typecheck:coverage:frontend",
    "ci": "deno task check:ci && deno task test:unit:parallel && E2E_SAFEGUARD=1 bun run test:e2e && deno task build",
    "commit:check": "deno run src/scripts/commit-check.ts --staged",
    "commit:lint": "deno run src/scripts/commit-check.ts --all",
    "config:generate-character-schema": "deno run src/config/generate-character-schema.ts",
    "config:generate-schema": "deno run src/config/generate-schema.ts",
    "config:generate-toml-schema": "deno run src/config/generate-toml-schema.ts",
    "context:weight": "deno run scripts/check-context-weight.ts",
    "context:weight:json": "deno run scripts/check-context-weight.ts --json",
    "context:weight:strict": "deno run scripts/check-context-weight.ts --strict",
    "db:migrate": "deno run src/db/migrate.ts",
    "db:reinit": "deno run src/db/reinit.ts",
    "db:schemas:check": "deno run scripts/check-db-schemas.ts",
    "db:sync-manifest": "deno run scripts/generate-schema-manifest.ts",
    "db:sync-types": "deno run scripts/generate-db-types.ts",
    "dead:code": "knip",
    "dead:code:ci": "knip --ci",
    "deno:config": "deno run scripts/gen-deno-config.ts",
    "deno:config:check": "deno run scripts/gen-deno-config.ts --check",
    "dev": "deno task build:frontend && deno run --watch src/server/index.ts",
    "docs:build": "deno run -A npm:vitepress build docs",
    "docs:dev": "deno run -A npm:vitepress dev docs",
    "docs:preview": "deno run -A npm:vitepress preview docs",
    "format": "dprint check",
    "format:dprint": "dprint check",
    "format:dprint:fix": "dprint fmt",
    "format:fix": "dprint fmt",
    "format:write": "dprint fmt",
    "i18n:check": "deno run scripts/i18n-reconcile.ts",
    "i18n:fix": "deno run scripts/i18n-reconcile.ts --fix",
    "jscpd": "jscpd src/ --min-lines 8 --min-tokens 100 --ignore '**/*.test.ts,**/migrations/*'",
    "jscpd:full": "jscpd src/ --min-lines 4 --min-tokens 30 --ignore '**/migrations/*,**/*.test.ts'",
    "license:check": "deno run scripts/check-licenses.ts",
    "license:check:strict": "LICENSE_CHECK=1 bun run scripts/check-licenses.ts --strict",
    "license:install:fossa": "curl -H 'Cache-Control: no-cache' https://raw.githubusercontent.com/fossas/fossa-cli/master/install-latest.sh | bash",
    "license:install:scancode": "pip install scancode-toolkit",
    "lint": "eslint .",
    "lint:biome": "biome lint docs/",
    "lint:biome:fix": "biome lint --write docs/",
    "lint:chaining": "deno run scripts/check-chaining.ts",
    "lint:css": "stylelint \"src/public/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"src/public/**/*.css\"",
    "lint:fix": "eslint . --fix",
    "lint:html": "markuplint --allow-warnings \"src/views/**/*.html\" \"src/components/**/*.html\"",
    "lint:html-scripts": "deno run scripts/check-html-scripts.ts",
    "lint:html:fix": "markuplint --fix \"src/views/**/*.html\" \"src/components/**/*.html\"",
    "md:links": "deno run scripts/check-md-links.ts",
    "md:links:fix": "deno run scripts/check-md-links.ts --fix",
    "md:lint": "markdownlint-cli2 \"docs/**/*.md\" \".plan/**/*.md\"",
    "md:lint:fix": "markdownlint-cli2 --fix \"docs/**/*.md\" \".plan/**/*.md\"",
    "openapi": "deno run scripts/gen-openapi.ts",
    "plan:docs": "deno run scripts/gen-plan-docs.ts",
    "plan:sync": "deno run scripts/sync-ticket-index.ts",
    "plan:sync:fix": "deno run scripts/sync-ticket-index.ts --fix",
    "schemas:check": "deno run scripts/check-schemas.ts",
    "schemas:check:fix": "deno run scripts/fix-schemas.ts",
    "size:check": "deno run scripts/check-file-size.ts",
    "spdx:check": "deno run scripts/check-spdx.ts",
    "start": "deno run src/server/index.ts",
    "test": "deno test --isolate",
    "test:all": "deno task build:frontend && deno test && deno task test:e2e:browser",
    "test:coverage": "deno test --coverage",
    "test:e2e": "HTTP_PROXY= NO_PROXY=* bun test tests/e2e/",
    "test:e2e:browser": "for f in tests/e2e/flows/browser/*.browser.ts; do bun test --max-concurrency=1 \"./$f\" || exit 1; sleep 0.3; done",
    "test:e2e:smoke": "deno test ./tests/e2e/flows/browser/smoke.browser.ts",
    "test:parallel": "deno task test:unit:parallel & bun run test:e2e & wait",
    "test:unit": "deno test src/ --isolate",
    "test:unit:parallel": "deno test src/ --concurrency=$(nproc)",
    "test:watch": "deno test --watch",
    "tui": "deno run src/tui/app.ts",
    "typecheck": "tsc --noEmit --project tsconfig.backend.json",
    "typecheck:coverage": "type-coverage --strict --at-least 90 --project tsconfig.backend.json",
    "typecheck:coverage:frontend": "type-coverage --strict --at-least 90 --project tsconfig.frontend.json",
    "typecheck:frontend": "tsc --noEmit --project tsconfig.frontend.json",
    "version:bump": "deno run src/scripts/version-bump.ts --bump",
    "version:predict": "deno run src/scripts/version-bump.ts",
    "version:sync": "deno run src/scripts/version-bump.ts --sync"
  },
  "unstable": [
    "sloppy-imports"
  ]
}
