{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "indentWidth": 2,
  "lineWidth": 120,
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/data",
    "**/.tmp",
    "**/.hermes",
    "**/docs/.vitepress",
    "**/plugins",
    "bun.lock",
    "*.har"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.93.0.wasm",
    "https://plugins.dprint.dev/json-0.19.4.wasm",
    "https://plugins.dprint.dev/markdown-0.17.8.wasm",
    "https://plugins.dprint.dev/css-0.16.3.wasm",
    "https://plugins.dprint.dev/html-0.26.4.wasm"
  ]
}
