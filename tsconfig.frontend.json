{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@loop-lore/core": ["./packages/core/src/index.ts"],
      "@loop-lore/core/*": ["./packages/core/src/*"],
      "@loop-lore/i18n": ["./packages/i18n/src/index.ts"],
      "@loop-lore/i18n/*": ["./packages/i18n/src/*"],
      "@loop-lore/assets": ["./packages/assets/src/index.ts"],
      "@loop-lore/assets/*": ["./packages/assets/src/*"],
      "@loop-lore/plugins": ["./packages/plugins/src/index.ts"],
      "@loop-lore/plugins/root/*": ["./packages/plugins/*"],
      "@loop-lore/plugins/*": ["./packages/plugins/src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "types": [
      "bun"
    ],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/frontend/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
