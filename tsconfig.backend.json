{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@loop-lore/core": ["./packages/core/src/index.ts"],
      "@loop-lore/core/*": ["./packages/core/src/*"],
      "@loop-lore/i18n": ["./packages/i18n/src/index.ts"],
      "@loop-lore/i18n/*": ["./packages/i18n/src/*"],
      "@loop-lore/assets": ["./packages/assets/src/index.ts"],
      "@loop-lore/assets/*": ["./packages/assets/src/*"],
      "@loop-lore/plugins": ["./packages/plugins/src/index.ts"],
      "@loop-lore/plugins/root/*": ["./packages/plugins/*"],
      "@loop-lore/plugins/*": ["./packages/plugins/src/*"]
    },
    "types": ["bun"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true
  },
  "include": ["src/**/*", "bin/**/*"],
  "exclude": ["node_modules", "dist", "src/frontend/**/*"]
}
