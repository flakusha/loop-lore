{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/package.json",
  "name": "loop-lore",
  "version": "0.1.0",
  "entryPoint": "src/server/index.ts",
  "license": "LGPL-3.0-or-later",
  "scripts": {
    "dev": "bun run build:frontend && bun run --watch src/server/index.ts",
    "start": "bun run src/server/index.ts",
    "tui": "bun run src/tui/app.ts",
    "build": "bun run build:frontend && bun run build:server && bun run build:native",
    "build:frontend": "bun run scripts/build-frontend.mjs",
    "build:server": "bun build src/server/index.ts --outdir ./dist --target bun",
    "build:native": "bun run scripts/build-native.ts",
    "lint:native": "cargo clippy --manifest-path native/loop-lore-native/Cargo.toml --all-targets -- -D warnings",
    "test:native": "cargo test --manifest-path native/loop-lore-native/Cargo.toml",
    "format:native": "cargo fmt --manifest-path native/loop-lore-native/Cargo.toml",
    "format:native:check": "cargo fmt --manifest-path native/loop-lore-native/Cargo.toml -- --check",
    "update:native": "cargo update --manifest-path native/loop-lore-native/Cargo.toml && cargo test --manifest-path native/loop-lore-native/Cargo.toml",
    "update:native:check": "cargo update --manifest-path native/loop-lore-native/Cargo.toml --dry-run",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:reinit": "bun run src/db/reinit.ts",
    "db:sync-types": "bun run scripts/generate-db-types.ts",
    "db:sync-manifest": "bun run scripts/generate-schema-manifest.ts",
    "openapi": "NODE_ENV=development bun run scripts/generate-openapi.ts",
    "schemas:check": "bun run scripts/check-schemas.ts",
    "schemas:check:fix": "bun run scripts/fix-schemas.ts",
    "config:generate-schema": "bun run src/config/generate-schema.ts",
    "config:generate-character-schema": "bun run src/config/generate-character-schema.ts",
    "config:generate-toml-schema": "bun run src/config/generate-toml-schema.ts",
    "sc": "bun run scripts/check-scenario-catalog.ts",
    "sc:gen": "bun run scripts/gen-scenario-catalog.ts",
    "sc:gate": "bun run sc:gen && bun run sc",
    "docs:dev": "bunx vitepress dev docs",
    "docs:build": "bunx vitepress build docs",
    "docs:preview": "bunx vitepress preview docs",
    "lint": "bun run lint:oxlint:advisory && bun run lint:eslint",
    "lint:oxlint": "bunx oxlint --ignore-pattern '**/*.test.ts' --ignore-pattern tests -D correctness .",
    "lint:oxlint:advisory": "bun run lint:oxlint > /dev/null 2>&1; echo '(oxlint advisory: tsc+eslint cover real correctness)'",
    "lint:eslint": "bunx eslint --concurrency=8 .",
    "lint:biome": "biome lint docs/",
    "lint:biome:fix": "biome lint --write docs/",
    "format": "dprint check",
    "format:fix": "dprint fmt",
    "md:lint": "markdownlint-cli2 \"docs/**/*.md\" \".plan/**/*.md\"",
    "md:lint:fix": "markdownlint-cli2 --fix \"docs/**/*.md\" \".plan/**/*.md\"",
    "md:links": "bun run scripts/check-md-links.ts",
    "md:links:fix": "bun run scripts/check-md-links.ts --fix",
    "typecheck": "tsgo --noEmit --project tsconfig.backend.json",
    "typecheck:tsc": "tsc --noEmit --project tsconfig.backend.json",
    "typecheck:frontend": "tsgo --noEmit --project tsconfig.frontend.json",
    "typecheck:frontend:tsc": "tsc --noEmit --project tsconfig.frontend.json",
    "typecheck:coverage": "type-coverage --strict --at-least 95 --project tsconfig.backend.json",
    "typecheck:coverage:frontend": "type-coverage --strict --at-least 95 --project tsconfig.frontend.json",
    "check": "bun run check:parallel",
    "check:parallel": "bun run scripts/check-parallel.mjs",
    "check:serial": "bun run check:typecheck && bun run lint && bun run format && bun run md:lint",
    "check:typecheck": "bun run typecheck && bun run typecheck:frontend && bun run typecheck:coverage && bun run typecheck:coverage:frontend",
    "check:ci": "bun run check:parallel --ci",
    "check:fix": "bun run check:parallel --fix",
    "check:report-ls": "bun run check:parallel --report-ls",
    "check:fast": "bun run check:parallel --gates 'typecheck - backend,typecheck - frontend,typecheck - scripts,lint - eslint,circular - imports (advisory),wiring - check,changelog - gate,db - schema gate,migrations - ordering,size - check,size - strict,no - shell - refs,frontend - innerHTML xss'",
    "check:default": "bun run check:parallel --skip-gates 'coverage - per-module line %,plan - validate,format - dprint,md - lint,dead - code (knip)'",
    "check:full": "bun run build:frontend && bun run check",
    "test": "bun test --parallel=${TEST_JOBS:-4} --isolate",
    "test:watch": "bun test --watch",
    "test:coverage": "E2E_SAFEGUARD=1 bun test --parallel=${TEST_JOBS:-4} tests/e2e/ src/ --coverage --isolate --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=.tmp/coverage",
    "test:unit": "bun test --parallel=${TEST_JOBS:-4} src/ --isolate",
    "test:e2e": "HTTP_PROXY= NO_PROXY=* bun test tests/e2e/",
    "test:e2e:browser": "for f in tests/e2e/flows/browser/*.browser.ts; do bun test --max-concurrency=1 \"./$f\" || exit 1; sleep 0.3; done",
    "test:e2e:smoke": "bun test ./tests/e2e/flows/browser/smoke.browser.ts",
    "test:all": "bun run build:frontend && bun test && bun run test:e2e:browser",
    "jscpd": "jscpd src/ --min-lines 8 --min-tokens 100 --ignore '**/*.test.ts,**/migrations/*,**/public/**,**/schema-manifest.ts,**/db-schemas.ts,**/insert-helpers.ts'",
    "jscpd:full": "jscpd src/ --min-lines 4 --min-tokens 30 --ignore '**/*.test.ts,**/migrations/*,**/public/**,**/schema-manifest.ts,**/db-schemas.ts,**/insert-helpers.ts' --reporters console,json --output .tmp/jscpd",
    "size:check": "bun run scripts/check-file-size.ts",
    "wiring:check": "bun run scripts/check-wiring.ts",
    "changelog:check": "bun run scripts/check-changelog.ts",
    "dead:code": "knip",
    "dead:code:ci": "knip --no-progress",
    "circular:check": "madge --circular --ts-config tsconfig.json --extensions ts,tsx --no-color src/ tests/ scripts/",
    "circular:summary": "madge --ts-config tsconfig.json --extensions ts,tsx --summary --warning src/ tests/ scripts/",
    "circular:graph": "madge --ts-config tsconfig.json --extensions ts,tsx --json src/ tests/ scripts/ > .tmp/madge-graph.json",
    "context:weight": "bun run scripts/check-context-weight.ts",
    "context:weight:json": "bun run scripts/check-context-weight.ts --json",
    "context:weight:strict": "bun run scripts/check-context-weight.ts --strict",
    "i18n:check": "bun run scripts/i18n-reconcile.ts",
    "i18n:fix": "bun run scripts/i18n-reconcile.ts --fix",
    "spdx:check": "bun run scripts/check-spdx.ts",
    "spdx:fix": "bun run scripts/check-spdx.ts --fix",
    "license:check": "bun run scripts/check-licenses.ts",
    "license:check:strict": "LICENSE_CHECK=1 bun run scripts/check-licenses.ts --strict",
    "plan:docs": "giwt plan gen-docs",
    "plan:docs:check": "giwt plan gen-docs --check",
    "plan:sync": "giwt sync",
    "plan:sync:fix": "giwt sync --fix",
    "plan:backlog:sync": "giwt plan backlog-sync",
    "plan:backlog:sync:fix": "giwt plan backlog-sync --fix",
    "plan:map": "giwt plan code-map",
    "plan:map:check": "giwt plan code-map --check",
    "plan:find": "giwt plan code-map --find",
    "plan:validate": "giwt plan validate",
    "plan:validate:fix": "giwt plan validate --fix",
    "plan:status": "giwt plan status",
    "deno:config": "bun run scripts/gen-deno-config.ts",
    "deno:config:check": "bun run scripts/gen-deno-config.ts --check",
    "deno:audit": "bun run scripts/audit-runtime-compat.ts",
    "deno:audit:shared": "bun run scripts/audit-runtime-compat.ts --shared",
    "deno:audit:json": "bun run scripts/audit-runtime-compat.ts --json",
    "deno:pkg:from-deno": "bun run scripts/gen-pkg-from-deno.ts",
    "deno:pkg:from-deno:check": "bun run scripts/gen-pkg-from-deno.ts --check",
    "version:predict": "bun run src/scripts/version-bump.ts",
    "version:bump": "bun run src/scripts/version-bump.ts --bump",
    "version:sync": "bun run src/scripts/version-bump.ts --sync",
    "commit:lint": "bun run src/scripts/commit-check.ts --all",
    "commit:check": "bun run src/scripts/commit-check.ts --staged",
    "bench": "bun run scripts/run-benchmarks.ts",
    "bench:native": "bun run scripts/run-benchmarks.ts blake3",
    "bench:ci": "bun run scripts/run-benchmarks.ts",
    "ci": "bun run check:ci && bun run test:unit && E2E_SAFEGUARD=1 bun run test:e2e && bun run build",
    "mermaid:lint": "bunx mmdlint docs/**/*.md .plan/**/*.md"
  },
  "dependencies": {
    "@alpinejs/morph": "^3.17.3",
    "@elysia/openapi": "^1.4.16",
    "@noble/hashes": "^2.4.0",
    "@optique/core": "^1.3.0",
    "@optique/run": "^1.3.0",
    "@sinclair/typebox": "^0.34.52",
    "alpinejs": "^3.17.3",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "clean-css": "^5.3.3",
    "dompurify": "^3.4.15",
    "elysia": "^1.4.30",
    "giwt": "github:flakusha/giwt#c53ffb5c9e09a6242b4a0cc60e27c05155b9811f",
    "htmx-ext-alpine-morph": "^2.0.2",
    "htmx-ext-sse": "^2.2.4",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.2",
    "kysely": "^0.29.6",
    "marked": "^18.0.13",
    "obscenity": "^0.4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@markuplint/html-spec": "^5.0.0",
    "@markuplint/mustache-parser": "5.0.0",
    "@mermaid-js/parser": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@sysid/mmdlint": "^0.1.1",
    "@types/blessed": "^0.1.27",
    "@types/bun": "^1.4.2",
    "@types/clean-css": "^4.2.11",
    "@types/dompurify": "^3.2.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.1",
    "@types/terser": "^3.12.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bun-plugin-html": "2.2.8",
    "dprint": "^0.57.4",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.5.2",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^75.0.0",
    "globals": "^17.12.0",
    "htmx.org": "2.0.10",
    "jscpd": "^5.2.1",
    "knip": "^6.36.0",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.23.2",
    "markuplint": "^5.0.0",
    "mermaid": "^12.0.0",
    "oxlint": "^1.83.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "type-coverage": "^2.30.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-renderer": "^1.2.2",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipAsyncImports": true,
        "skipTypeImports": true
      },
      "tsx": {
        "skipAsyncImports": true,
        "skipTypeImports": true
      }
    }
  }
}
