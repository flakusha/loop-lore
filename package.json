{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/package.json",
  "name": "loop-lore",
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "entryPoint": "src/server/index.ts",
  "license": "LGPL-3.0-or-later",
  "bin": {
    "lolo": "./bin/lolo.ts"
  },
  "scripts": {
    "dev": "bun run build:frontend && bun run --watch src/server/index.ts",
    "start": "bun run src/server/index.ts",
    "tui": "bun run src/tui/app.ts",
    "lolo": "bun run bin/lolo.ts",
    "build": "bun run build:frontend && bun run build:server && bun run build:native && bun run build:egui",
    "build:frontend": "bun run scripts/build-frontend.mjs",
    "build:egui": "bun run scripts/build-egui-wasm.ts",
    "build:server": "bun build src/server/index.ts --outdir ./dist --target bun",
    "build:native": "bun run scripts/build-native.ts",
    "build:verify": "bun run scripts/build-verify.ts",
    "lint:native": "cargo clippy -p loop-lore-native --all-targets -- -D warnings",
    "lint:egui": "cargo clippy -p loop-lore-egui --all-targets -- -D warnings",
    "test:native": "cargo test -p loop-lore-native",
    "native:toolchain": "bun run scripts/native/toolchain.ts",
    "format:native": "cargo fmt -p loop-lore-native",
    "format:egui": "cargo fmt -p loop-lore-egui",
    "format:egui:check": "cargo fmt -p loop-lore-egui -- --check",
    "test:egui": "cargo test -p loop-lore-egui",
    "format:native:check": "cargo fmt -p loop-lore-native -- --check",
    "update:native": "cargo update -p loop-lore-native && cargo test -p loop-lore-native",
    "update:native:check": "cargo update -p loop-lore-native --dry-run",
    "lint": "bun run lint:eslint",
    "lint:oxlint": "bunx oxlint --ignore-pattern '**/*.test.ts' --ignore-pattern tests -D correctness .",
    "lint:eslint": "bunx eslint --concurrency=4 --cache --cache-location .tmp/eslint.cache .",
    "lint:biome": "biome lint .",
    "lint:biome:fix": "biome lint --write docs/",
    "lint:css": "stylelint \"src/public/**/*.css\"",
    "lint:html": "markuplint --allow-warnings \"src/views/**/*.html\" \"src/components/**/*.html\"",
    "format": "dprint check",
    "format:fix": "dprint fmt",
    "typecheck": "tsgo --noEmit --project tsconfig.backend.json",
    "typecheck:bun": "bun --check",
    "typecheck:frontend": "tsgo --noEmit --project tsconfig.frontend.json",
    "typecheck:coverage": "type-coverage --strict --at-least 95 --project tsconfig.backend.json",
    "typecheck:coverage:frontend": "type-coverage --strict --at-least 95 --project tsconfig.frontend.json",
    "typecheck:coverage:scripts": "type-coverage --strict --at-least 95 --project tsconfig.scripts.json",
    "test": "bun test --parallel=${TEST_JOBS:-4} --isolate",
    "test:watch": "bun test --watch",
    "test:unit": "bun test --parallel=${TEST_JOBS:-4} src/ --isolate",
    "test:e2e": "E2E_SAFEGUARD=1 HTTP_PROXY= NO_PROXY=* bun test tests/e2e/",
    "test:e2e:browser": "E2E_SAFEGUARD=1 bun run scripts/run-browser-tests.ts",
    "test:e2e:smoke": "E2E_SAFEGUARD=1 bun test ./tests/e2e/flows/browser/smoke.browser.ts",
    "test:all": "bun run build:frontend && E2E_SAFEGUARD=1 bun test && E2E_SAFEGUARD=1 bun run test:e2e:browser",
    "test:coverage": "E2E_SAFEGUARD=1 bun test --parallel=${TEST_JOBS:-4} tests/e2e/ src/ plugins/ --coverage --isolate --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=.tmp/coverage",
    "test:gaps": "bun run scripts/check/test-gaps.mjs",
    "test:gaps:update": "bun run scripts/check/test-gaps.mjs --write-baseline",
    "check": "bun run check:parallel",
    "check:parallel": "bun run scripts/check-parallel.mjs",
    "check:serial": "bun run check:typecheck && bun run lint && bun run format && bun run md:lint",
    "check:typecheck": "bun run typecheck && bun run typecheck:bun && bun run typecheck:frontend && bun run typecheck:coverage && bun run typecheck:coverage:frontend && bun run typecheck:coverage:scripts",
    "check:ci": "bun run check:parallel --ci",
    "check:fix": "bun run check:parallel --fix",
    "check:report-ls": "bun run check:parallel --report-ls",
    "check:fast": "bun run check:parallel --gates 'typecheck - backend,typecheck - bun,typecheck - frontend,typecheck - scripts,lint - eslint,wiring - check,changelog - gate,db - schema gate,migrations - ordering,size - check,size - strict,no - shell - refs,frontend - template preflight,frontend - innerHTML xss'",
    "check:default": "bun run check:parallel --skip-gates 'coverage - per-module line %,plan - validate,format - dprint,md - lint,dead - code (knip)'",
    "check:full": "bun run build:frontend && bun run check",
    "ci": "bun run check:ci && bun run test:unit && E2E_SAFEGUARD=1 bun run test:e2e && E2E_SAFEGUARD=1 bun run test:e2e:browser && bun run build",
    "wiring:check": "bun run scripts/check-wiring.ts",
    "changelog:check": "bun run scripts/check-changelog.ts",
    "size": "bun run scripts/check-file-size.ts --strict",
    "size:check": "bun run scripts/check-file-size.ts --strict",
    "context:weight": "bun run scripts/check-context-weight.ts",
    "context:weight:json": "bun run scripts/check-context-weight.ts --json",
    "context:weight:strict": "bun run scripts/check-context-weight.ts --strict",
    "i18n:check": "bun run scripts/i18n-reconcile.ts",
    "i18n:fix": "bun run scripts/i18n-reconcile.ts --fix",
    "i18n:keys": "bun run scripts/check/i18n-keys.mjs",
    "spdx:check": "bun run scripts/check-spdx.ts",
    "spdx:fix": "bun run scripts/check-spdx.ts --fix",
    "license:check": "bun run scripts/check-licenses.ts",
    "license:check:strict": "LICENSE_CHECK=1 bun run scripts/check-licenses.ts --strict",
    "dead:code": "knip && knip --no-gitignore --include dependencies,unlisted,binaries",
    "dead:code:ci": "knip --no-progress && knip --no-gitignore --include dependencies,unlisted,binaries --no-progress",
    "dead:code:src": "knip --no-gitignore --include files",
    "dead:code:src:full": "knip --no-gitignore",
    "dead:code:src:ci": "knip --no-gitignore --no-progress",
    "jscpd": "bun scripts/check/jscpd-scan.mjs --min-lines 8 --min-tokens 100",
    "jscpd:full": "bun scripts/check/jscpd-scan.mjs --min-lines 4 --min-tokens 30 --reporters console,json --output .tmp/jscpd",
    "jscpd:ratchet": "bun scripts/check/jscpd-ratchet.mjs",
    "circular:check": "madge --circular --ts-config tsconfig.json --extensions ts,tsx --no-color src/ tests/ scripts/",
    "circular:summary": "madge --ts-config tsconfig.json --extensions ts,tsx --summary --warning src/ tests/ scripts/",
    "circular:graph": "madge --ts-config tsconfig.json --extensions ts,tsx --json src/ tests/ scripts/ > .tmp/madge-graph.json",
    "fuzz:gen": "bun run scripts/generate-schema-fuzz.ts",
    "fuzz:check": "bun run scripts/generate-schema-fuzz.ts --check",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:reinit": "bun run src/db/reinit.ts",
    "db:sync-types": "bun run scripts/generate-db-types.ts",
    "db:sync-manifest": "bun run scripts/generate-schema-manifest.ts",
    "seed:users": "bun run scripts/seed-users.ts",
    "migrate:character:legacy": "bun run src/scripts/migrate-character-legacy.ts",
    "backfill:users:encryption-secret": "bun run src/scripts/backfill-users-encryption-secret.ts",
    "backfill:users:encryption-secret:dry": "bun run src/scripts/backfill-users-encryption-secret.ts --dry-run",
    "schemas:check": "bun run scripts/check-schemas.ts",
    "schemas:check:fix": "bun run scripts/fix-schemas.ts",
    "openapi": "NODE_ENV=development bun run scripts/generate-openapi.ts",
    "check:templates": "bun run scripts/check-frontend-templates.ts",
    "config:generate-schema": "bun run src/config/generate-schema.ts",
    "config:generate-character-schema": "bun run src/config/generate-character-schema/index.ts",
    "config:generate-toml-schema": "bun run src/config/generate-toml-schema.ts",
    "config:generate-env-schema": "bun run src/config/generate-env-schema.ts",
    "config:generate-domain-schemas": "bun run src/config/generate-domain-schemas.ts",
    "smoke:app": "bun run src/scripts/smoke-app.ts",
    "plan:docs": "giwt plan gen-docs",
    "plan:docs:check": "giwt plan gen-docs --check",
    "plan:sync": "giwt sync",
    "plan:sync:fix": "giwt sync --fix",
    "plan:matrix": "giwt plan matrix",
    "plan:matrix:check": "giwt plan matrix --check",
    "plan:priority": "bun run scripts/plan-priority.ts",
    "plan:priority:check": "bun run scripts/plan-priority.ts --check",
    "plan:map": "giwt plan code-map",
    "plan:map:check": "giwt plan code-map --check",
    "plan:find": "giwt plan code-map --find",
    "plan:links": "giwt plan links --write",
    "plan:links:check": "giwt plan links --check",
    "plan:validate": "giwt plan validate",
    "plan:validate:fix": "giwt plan validate --fix",
    "plan:status": "giwt plan status",
    "plan:status:normalize": "giwt plan normalize-statuses",
    "plan:status:normalize:check": "giwt plan normalize-statuses --check",
    "plan:metadata": "giwt plan metadata",
    "plan:metadata:check": "giwt plan metadata --dry-run",
    "plan:report": "giwt plan report",
    "docs:dev": "giwt plan sync-docs && bunx vitepress dev docs",
    "docs:build": "giwt plan sync-docs && bunx vitepress build docs",
    "docs:preview": "giwt plan sync-docs && bunx vitepress preview docs",
    "md:lint": "markdownlint-cli2 \"docs/**/*.md\" \".plan/**/*.md\"",
    "md:lint:fix": "markdownlint-cli2 --fix \"docs/**/*.md\" \".plan/**/*.md\"",
    "md:links": "bun run scripts/check-md-links.ts",
    "md:links:fix": "bun run scripts/check-md-links.ts --fix",
    "mermaid:lint": "bunx mmdlint docs/**/*.md .plan/**/*.md",
    "version:predict": "bun run src/scripts/version-bump.ts",
    "version:bump": "bun run src/scripts/version-bump.ts --bump",
    "version:sync": "bun run src/scripts/version-bump.ts --sync",
    "commit:lint": "bun run src/scripts/commit-check.ts --all",
    "commit:check": "bun run src/scripts/commit-check.ts --staged",
    "logs:query": "bun run src/scripts/log-query.ts",
    "bench": "bun run scripts/run-benchmarks.ts",
    "bench:native": "bun run scripts/run-benchmarks.ts blake3",
    "bench:ci": "bun run scripts/run-benchmarks.ts",
    "eval:prompts": "bun run src/aux-pipeline/eval/cli.ts",
    "deno:config": "bun run scripts/gen-deno-config.ts",
    "deno:config:check": "bun run scripts/gen-deno-config.ts --check",
    "deno:audit": "bun run scripts/audit-runtime-compat.ts",
    "deno:audit:shared": "bun run scripts/audit-runtime-compat.ts --shared",
    "deno:audit:json": "bun run scripts/audit-runtime-compat.ts --json",
    "audit:branches": "bun run scripts/audit-branches.ts",
    "audit:branches:json": "bun run scripts/audit-branches.ts --json",
    "audit:branches:strict": "bun run scripts/audit-branches.ts --strict",
    "deno:pkg:from-deno": "bun run scripts/gen-pkg-from-deno.ts",
    "deno:pkg:from-deno:check": "bun run scripts/gen-pkg-from-deno.ts --check"
  },
  "dependencies": {
    "@alpinejs/morph": "3.17.5",
    "@elysia/openapi": "^1.4.16",
    "@noble/hashes": "^2.4.0",
    "@oh-my-pi/pi-tui": "18.14.2",
    "@optique/core": "^1.3.6",
    "@optique/run": "^1.3.6",
    "@sinclair/typebox": "^0.34.52",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "alpinejs": "3.17.5",
    "clean-css": "^5.3.3",
    "dompurify": "^3.4.17",
    "effect": "4.1.1",
    "elysia": "^1.4.30",
    "giwt": "github:flakusha/giwt",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.2",
    "kysely": "0.29.8",
    "marked": "^18.1.2",
    "obscenity": "^0.4.6",
    "sharp": "^0.35.5",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@markuplint/html-spec": "5.4.0",
    "@markuplint/mustache-parser": "5.4.0",
    "@mermaid-js/parser": "^2.0.1",
    "@playwright/test": "^1.64.1",
    "@sysid/mmdlint": "^0.1.1",
    "@types/bun": "^1.4.4",
    "@types/clean-css": "^4.2.11",
    "@types/dompurify": "^3.2.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bun-plugin-html": "2.2.8",
    "dprint": "0.64.3",
    "eslint": "10.14.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "htmx.org": "4.0.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "madge": "^8.0.0",
    "markdownlint-cli2": "0.24.0",
    "markuplint": "5.4.0",
    "mermaid": "^12.2.0",
    "oxlint": "1.90.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "type-coverage": "^2.31.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-renderer": "^1.2.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipAsyncImports": true,
        "skipTypeImports": true
      },
      "tsx": {
        "skipAsyncImports": true,
        "skipTypeImports": true
      }
    }
  },
  "private": true
}
