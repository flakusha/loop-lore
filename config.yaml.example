# loop-lore configuration
# Supports: YAML (.yaml, .yml) or TOML (.toml)
# Env vars override values below — see src/config/load.ts for mapping
# $schema: ./schemas/loop-lore-config.schema.json

server:
  port: 3000
  host: "localhost"
  tls:
    key: "../loop-lore-data/certs/key.pem"      # auto-generated if missing
    cert: "../loop-lore-data/certs/cert.pem"    # auto-generated if missing

db:
  type: sqlite          # "sqlite" or "postgres"
  sqliteFilename: "../loop-lore-data/loop-lore.db"
  # For Postgres:
  # type: postgres
  # url: "postgres://user:pass@localhost:5432/loop-lore"

assets:
  enabled: true
  uploadDir: "../loop-lore-data/uploads"
  maxFileSize: 10485760  # 10 MB
  compression: true

assistant:
  enabled: true

logging:
  level: debug          # debug | info | warn | error
  # jsonlPath: "./data/logs/loop-lore.jsonl"   # enable JSONL output
  # jsonlMaxBytes: 104857600                   # 100 MB rotation
  # jsonlMaxFiles: 5
  # dbEnabled: false                           # log_entries table
  # censorEnabled: true                        # PII redaction (default)
  # censorFields: ["x-api-key", "authorization"]
  # queueMaxSize: 10000
  # maxMessageBytes: 10240
  # maxMetaBytes: 102400
  # maxMetaDepth: 5
  # maxStackBytes: 5120

tui:
  enabled: true

docs:
  enabled: true
  # public: ["guide", "frontend", "assets", "actors"]    # uncomment to restrict visible sections

auth:
  required: false             # true = remote auth, false = solo/demo mode
  registrationOpen: true
  sessionTimeoutHours: 24
  maxSessionsPerUser: 10
  demoUsername: demo
  demoAutoSetup: true

# ── Age Gate ──
ageGate:
  enabled: false
  minimumAge: 18
  mode: self-declaration    # none | self-declaration | verification

# ── Transport ──
transport:
  defaultProtocol: http/1.1
  enableWebSocket: true
  enableWebTransport: false
  enableH2: false
  enableH3: false
  compression:
    enabled: false
    default: none
    threshold: 256
  limits:
    maxFrameSize: 65536
    maxPayload: 327680
    maxConcurrentStreams: 100

# ── Messages ──
messages:
  autoHideInvalid: false
  hideConfirmation: true
  maxLength: 100000
  maxGenerationRetries: 3
  generationTimeoutMs: 30000
  idempotencyExpiryHours: 24

# ── NSFW ──
nsfw:
  allowNsfw: true
  nsfwMinAge: 18

# ── Generation (LLM Providers) ──
generation:
  providers:
    openaiCompatible: []
    # Example provider:
    # - name: default
    #   label: "Default Provider"
    #   baseUrl: http://localhost:8080/v1
    #   apiKey: "sk-optional"
    #   model: claude-3-opus
    #   timeout: 30000
    #   retries: 3
    #   allowUserApiKey: true
    #   models:
    #     claude-3-opus: { contextLimit: 200000, maxOutput: 4000 }
  defaultProvider: ""
  defaultModels: {}

  # ── Auto-start external AI servers (optional) ──
  # Uncomment to spawn llama.cpp / sd-server as child processes at startup.
  # Servers are skipped gracefully if binaries not found.
  # autoStart:
  #   llamaCpp:
  #     enabled: true
  #     modelPath: "org/repo:Q4_K_M"           # HF ref or /path/to/model.gguf
  #     port: 9011
  #     ctxSize: 8192
  #     extraArgs: ["--alias", "my-model"]
  #   sdCpp:
  #     enabled: true
  #     modelPath: "/path/to/model.safetensors"
  #     port: 9010
  #     llmPath: "/path/to/text-encoder.gguf"
  #     vaePath: "/path/to/vae.safetensors"
  #     loraDir: "/path/to/loras"
  #     extraArgs: ["--offload-to-cpu"]

# ── BYO API Keys ──
byoKey:
  enabled: true
  # encryptionKey: "optional-override-for-auth.sessionSecret"