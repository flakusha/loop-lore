  "render": [
    {
      "input": "hello :fire:",
      "expected": "hello 🔥"
    },
    {
      "input": "no emoji here",
      "expected": "no emoji here"
    },
    {
      "input": ":heart: :heart:",
      "expected": "❤️ ❤️"
    },
    {
      "input": "`:fire:`",
      "expected": "`:fire:`"
    },
    {
      "input": "code `:fire:` inline",
      "expected": "code `:fire:` inline"
    },
    {
      "input": ":unknown: stays",
      "expected": ":unknown: stays"
    },
    {
      "input": ":FIRE: stays",
      "expected": ":FIRE: stays"
    },
    {
      "input": "mixed :fire: and :unknown:",
      "expected": "mixed 🔥 and :unknown:"
    },
    {
      "input": ":+1: works",
      "expected": "👍 works"
    },
    {
      "input": "a :fire: b :heart: c",
      "expected": "a 🔥 b ❤️ c"
    },
    {
      "input": "",
      "expected": ""
    },
    {
      "input": ":",
      "expected": ":"
    },
    {
      "input": "::",
      "expected": "::"
    },
    {
      "input": "text `code :fire:` more :heart:",
      "expected": "text `code :fire:` more ❤️"
    },
    {
      "input": ":fire::heart:",
      "expected": "🔥❤️"
    },
    {
      "input": "  :zap:  ",
      "expected": "  ⚡  "
    },
    {
      "input": ":fire: :heart: :moon:",
      "expected": "🔥 ❤️ 🌙"
    },
    {
      "input": "a`b`:fire:`c`",
      "expected": "a`b`🔥`c`"
    },
    {
      "input": "`unclosed :fire:",
      "expected": "`unclosed 🔥"
    },
    {
      "input": ":constructor: stays",
      "expected": ":constructor: stays"
    }
  ],
