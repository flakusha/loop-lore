# TEMPLATE — provisioning required before installing.
# The repo ships no off-box push implementation; provision your own zfs
# send/recv script and point ExecStart at it (current path is a placeholder).
[Unit]
Description=Loop-Lore off-box ZFS snapshot push
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/opt/loop-lore/scripts/backup/zfs-send-offsite.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

StandardOutput=journal
StandardError=journal
SyslogIdentifier=loop-lore-backup-zfs
