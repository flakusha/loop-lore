[Unit]
Description=Loop-Lore SQLite logical backup
After=loop-lore.service
Wants=loop-lore.service

[Service]
Type=oneshot
User=loop-lore
Group=loop-lore
WorkingDirectory=/opt/loop-lore
ExecStart=/opt/loop-lore/scripts/backup/sqlite-snapshot.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

StandardOutput=journal
StandardError=journal
SyslogIdentifier=loop-lore-backup-sqlite
