# ── Telemetry (observability) ──
# Master switch — enables events + frontend ingestion + admin analytics.
# TELEMETRY_ENABLED=1
# Record events to DB (generation/tool/frontend). Implied by TELEMETRY_ENABLED.
# TELEMETRY_EVENTS_ENABLED=1
# Accept frontend-sent events (POST /api/telemetry/event). Implied by TELEMETRY_ENABLED.
# TELEMETRY_FRONTEND_ENABLED=1
# Retention window (days) for the purge endpoint. Default 90.
# TELEMETRY_RETENTION_DAYS=90
# TLS_CERT=
# TLS_KEY=
