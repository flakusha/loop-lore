# loop-lore configuration (TOML format)
# Supports: YAML (.yaml, .yml) or TOML (.toml)
# Env vars override values below — see src/config/load.ts for mapping
# $schema: ./schemas/loop-lore-config.toml.schema.json

[server]
port = 3000
host = "localhost"

[server.tls]
key = "../loop-lore-data/certs/key.pem"
cert = "../loop-lore-data/certs/cert.pem"

[db]
type = "sqlite"
sqliteFilename = "../loop-lore-data/loop-lore.db"

# For Postgres:
# type = "postgres"
# url = "postgres://user:pass@localhost:5432/loop-lore"

[assets]
enabled = true
uploadDir = "../loop-lore-data/uploads"
maxFileSize = 10485760
compression = true

[assistant]
enabled = true

[logging]
level = "debug"

# JSONL output (optional)
# jsonlPath = "./data/logs/loop-lore.jsonl"
# jsonlMaxBytes = 104857600
# jsonlMaxFiles = 5

[tui]
enabled = true

[docs]
enabled = true
# public = ["guide", "frontend", "assets", "actors"]

[auth]
required = false
registrationOpen = true
sessionTimeoutHours = 24
maxSessionsPerUser = 10
demoUsername = "demo"
demoAutoSetup = true

[ageGate]
enabled = false
minimumAge = 18
mode = "self-declaration"

[transport]
defaultProtocol = "http/1.1"
enableWebSocket = true
enableWebTransport = false
enableH2 = false
enableH3 = false

[transport.compression]
enabled = false
default = "none"
threshold = 256

[transport.limits]
maxFrameSize = 65536
maxPayload = 327680
maxConcurrentStreams = 100

[messages]
autoHideInvalid = false
hideConfirmation = true
maxLength = 100000
maxGenerationRetries = 3
generationTimeoutMs = 30000
idempotencyExpiryHours = 24

[nsfw]
allowNsfw = true
nsfwMinAge = 18

[generation]
defaultProvider = ""
defaultModels = {}

[generation.providers]
openaiCompatible = []

# Example provider:
# [[generation.providers.openaiCompatible]]
# name = "default"
# label = "Default Provider"
# baseUrl = "http://localhost:8080/v1"
# apiKey = "sk-optional"
# model = "claude-3-opus"
# timeout = 30000
# retries = 3
# allowUserApiKey = true

# Example model limits:
# [generation.providers.openaiCompatible.models.claude-3-opus]
# contextLimit = 200000
# maxOutput = 4000

# Example auto-start (spawn llama.cpp / sd-server as child processes):
# [generation.autoStart.llamaCpp]
# enabled = true
# modelPath = "org/repo:Q4_K_M"        # HF ref or /path/to/model.gguf
# port = 9011
# alias = "my-model"                   # model alias for API
# ctxSize = 8192
# threads = -1                         # -1 = auto
# nGpuLayers = "auto"                  # auto, all, or number
# device = "0"                         # GPU device list
# mlock = true
# cacheTypeK = "iq4_nl"
# cacheTypeV = "iq4_nl"
# cacheRam = 49152
# flashAttn = "on"
# swaFull = true
# ropeScaling = "yarn"
# ropeScale = 4.0
# temp = 1.0
# topK = 40
# topP = 0.95
# minP = 0.01
# repeatPenalty = 1.05
# parallelRequests = 1
# fit = true
# specType = "draft-eagle3,ngram-map-k4v"
# specDraftNMin = 0
# specDraftNMax = 4
# reasoningBudget = -1
# jinja = true
# extraArgs = ["--log-colors", "on"]
#
# [generation.autoStart.sdCpp]
# enabled = true
# modelType = "checkpoint"             # checkpoint (-m) or diffusion (--diffusion-model)
# modelPath = "/path/to/model.safetensors"
# port = 9010
# # ── For diffusion modelType ──
# # llmPath = "/path/to/text-encoder.gguf"
# # clipLPath = "/path/to/clip-l.gguf"
# # clipGPath = "/path/to/clip-g.gguf"
# # t5xxlPath = "/path/to/t5xxl.gguf"
# # ── Model components ──
# # vaePath = "/path/to/vae.safetensors"
# # vaeFormat = "auto"
# # controlNetPath = "/path/to/control-net.safetensors"
# # loraDir = "/path/to/loras"
# # taesdPath = "/path/to/taesd.safetensors"
# # hiresUpscalersDir = "/path/to/upscalers"
# # embdDir = "/path/to/embeddings"
# # photoMakerPath = "/path/to/photomaker.safetensors"
# # upscaleModelPath = "/path/to/esrgan.safetensors"
# # ── Performance ──
# # fa = true
# # diffusionFA = true
# # vaeTiling = true
# # eagerLoad = true
# # offloadToCPU = true
# # streamLayers = true
# # autoFit = true
# # maxVram = "6"
# # backend = "clip=cpu,vae=cpu"
# # rng = "cpu"
# # samplerRng = "cpu"
# # type = "q8_0"
# # prediction = "eps"
# # cacheMode = "spectrum"
# # cacheOption = "threshold=0.25"
# # extraArgs = ["--color"]

[byoKey]
enabled = true
# encryptionKey = "optional-override-for-auth.sessionSecret"

[encryption]
required = false
compressThreshold = 128
# compressAlgorithm = "gzip"          # gzip | brotli | zstd

# ── Response Headers (FExBE: security / isolation / perf / observability) ──
[headers]
enabled = true
referrerPolicy = "strict-origin-when-cross-origin"
xContentTypeOptions = true
xFrameOptions = "DENY"
permissionsPolicy = "accelerometer=(), camera=(), geolocation=(), microphone=(), usb=()"

[headers.csp]
enabled = true
defaultSrc = ["'self'"]
scriptSrc = ["'self'"]   # self-hosted Alpine + htmx
styleSrc = ["'self'", "'unsafe-inline'"]   # inline style= attrs need unsafe-inline
imgSrc = ["'self'", "data:", "blob:"]
fontSrc = ["'self'"]
connectSrc = ["'self'", "wss:", "https:"]
objectSrc = ["'none'"]
baseUri = ["'self'"]
frameAncestors = ["'none'"]
upgradeInsecureRequests = true
# reportOnly = false                  # true = emit Content-Security-Policy-Report-Only (observe, don't enforce)

# crossOriginOpenerPolicy = ""        # same-origin | same-origin-allow-popups | "" (omit)
# crossOriginEmbedderPolicy = ""      # require-corp | "" (omit; keep off until wasm/SAB ready)
crossOriginResourcePolicy = "cross-origin"
immutableHashedAssets = true
linkPreload = ["/vendor.js", "/app.js", "/css/app.css"]
# acceptClientHints = ["Device-Memory", "RTT"]
earlyHints = { enabled = false }
# nel = '{ "report_to": "default", "max_age": 31536000 }'
