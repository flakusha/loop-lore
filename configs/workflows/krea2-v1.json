{
  "1": {
    "inputs": {
      "filename_prefix": "comfyui/krea2/krea2-%date:yyyy-MM-dd-hh-mm-ss%",
      "images": [
        "2",
        0
      ],
      "format": "png",
      "format.bit_depth": "8-bit",
      "format.input_color_space": "sRGB",
      "format.channels": "auto"
    },
    "class_type": "SaveImageAdvanced",
    "_meta": {
      "title": "Save Image (Advanced)"
    }
  },
  "2": {
    "inputs": {
      "enabled": true,
      "mode": "auto",
      "limit": 0.02,
      "skip_when_clean": true,
      "grid_gain": 10,
      "grid_view": "4x zoom",
      "image": [
        "3",
        0
      ]
    },
    "class_type": "VAEDeGrid",
    "_meta": {
      "title": "VAE DeGrid (Nyquist Notch)"
    }
  },
  "3": {
    "inputs": {
      "samples": [
        "6",
        0
      ],
      "vae": [
        "4",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "4": {
    "inputs": {
      "vae_name": "qwen/qwen_image_vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "6": {
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg_scale}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "denoise": 1,
      "model": [
        "8",
        0
      ],
      "positive": [
        "10",
        0
      ],
      "negative": [
        "11",
        0
      ],
      "latent_image": [
        "12",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "7": {
    "inputs": {
      "unet_name": "krea2/krea2.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "8": {
    "inputs": {
      "attention": "{{attention}}",
      "model": [
        "7",
        0
      ]
    },
    "class_type": "ModelAttentionBackend",
    "_meta": {
      "title": "Model Attention Backend"
    }
  },
  "9": {
    "inputs": {
      "clip_name": "krea2/krea2-qwen3-vl-4b.safetensors",
      "type": "krea2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP"
    }
  },
  "10": {
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "9",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Prompt)"
    }
  },
  "11": {
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": [
        "9",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Prompt)"
    }
  },
  "12": {
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent Image"
    }
  }
}
