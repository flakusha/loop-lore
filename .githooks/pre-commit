#!/bin/sh
# Pre-commit hook for loop-lore — staged files only (fast)
#
# Checks only staged files for formatting + lint.
# For full checks: run `bun run check` or use pre-commit:full.
# Install: git config core.hooksPath .githooks && chmod +x .githooks/pre-commit

set -u

failures=0
TMPDIR="${TMPDIR:-/tmp}/loop-lore-precommit-$$"
mkdir -p "$TMPDIR"
trap 'rm -rf "$TMPDIR"' EXIT

red() { printf "\033[31m%s\033[0m\n" "$*"; }
green() { printf "\033[32m%s\033[0m\n" "$*"; }
yellow() { printf "\033[33m%s\033[0m\n" "$*"; }
cyan() { printf "\033[36m%s\033[0m\n" "$*"; }

echo ""
echo "=== loop-lore pre-commit (staged files) ==="
echo ""

# ── Step 0: Co-Authored-By trailer attribution ───────────────
# A Co-Authored-By trailer is only attribution if the identity it names authors
# or commits in the set being landed; 14 fabricated trailers on dev named
# agents that appear nowhere in the author/committer population.
#
# --range is REQUIRED here, not optional: with no argument the script audits
# the commit message on stdin, and pre-commit runs with empty stdin — the
# check would report success while auditing nothing. --range with no value
# audits this branch's unmerged range (the commits being finalized).
#
# The message being written is checked separately, in prepare-commit-msg,
# which is the only hook that has a message file.
echo "--- Step 0: Co-Authored-By trailers ---"
# A worktree can have this hook without the script (17 of 19 under tree/ did).
# `bun run` on a missing module exits 1 — the same code as a real finding —
# so the guard is what keeps a tooling gap out of the policy report.
if [ ! -f "scripts/check/co-author-trailers.mjs" ]; then
  yellow "  ⚠ co-author-trailers check missing — skipping (tooling gap, not a trailer violation)"
elif bun run scripts/check/co-author-trailers.mjs --range >/dev/null; then
  green "  ✓ Co-Authored-By trailers name real identities"
else
  status=$?
  if [ "$status" -eq 1 ]; then
    red "  ✗ Unattributed Co-Authored-By trailer(s)"
  else
    red "  ✗ Co-Authored-By check could not run (exit $status) — tooling failure, not a trailer violation"
  fi
  failures=$((failures + 1))
fi
echo ""
# ── Get staged files ──────────────────────────────────────────
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' || true)
STAGED_CSS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.css$' || true)
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.mdx?$' || true)
STAGED_HTML=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.html$' || true)
STAGED_JSON=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.json$' || true)
STAGED_SH=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.sh$' || true)

# Skipping the FILE gates must not skip Step 0: a commit staging only files
# no file gate covers (.txt, .sql, ...) reaches here with every STAGED_* empty,
# and an unconditional exit 0 would discard a Step 0 failure already counted.
if [[ -z "$STAGED_TS" && -z "$STAGED_CSS" && -z "$STAGED_MD" && -z "$STAGED_HTML" && -z "$STAGED_JSON" && -z "$STAGED_SH" ]]; then
  yellow "No staged files for file gates — skipping"
  if [ "$failures" -gt 0 ]; then
    red "=== $failures check(s) failed — commit blocked ==="
    red "To commit without checks: git commit --no-verify"
    exit 1
  fi
  exit 0
fi

echo "Staged files:"
[[ -n "$STAGED_TS" ]] && echo "  TS/TSX: $(echo "$STAGED_TS" | wc -l | tr -d ' ')"
[[ -n "$STAGED_CSS" ]] && echo "  CSS: $(echo "$STAGED_CSS" | wc -l | tr -d ' ')"
[[ -n "$STAGED_MD" ]] && echo "  MD: $(echo "$STAGED_MD" | wc -l | tr -d ' ')"
[[ -n "$STAGED_HTML" ]] && echo "  HTML: $(echo "$STAGED_HTML" | wc -l | tr -d ' ')"
[[ -n "$STAGED_JSON" ]] && echo "  JSON: $(echo "$STAGED_JSON" | wc -l | tr -d ' ')"
[[ -n "$STAGED_SH" ]] && echo "  SH: $(echo "$STAGED_SH" | wc -l | tr -d ' ')"
echo ""

# ── Step 1: Auto-fix formatting on staged files ───────────────
echo "--- Step 1: Format staged files ---"
FORMAT_FILES=""
[[ -n "$STAGED_TS" ]] && FORMAT_FILES="$FORMAT_FILES $STAGED_TS"
[[ -n "$STAGED_CSS" ]] && FORMAT_FILES="$FORMAT_FILES $STAGED_CSS"
[[ -n "$STAGED_MD" ]] && FORMAT_FILES="$FORMAT_FILES $STAGED_MD"
[[ -n "$STAGED_HTML" ]] && FORMAT_FILES="$FORMAT_FILES $STAGED_HTML"
[[ -n "$STAGED_JSON" ]] && FORMAT_FILES="$FORMAT_FILES $STAGED_JSON"

if [[ -n "$FORMAT_FILES" ]]; then
  if echo "$FORMAT_FILES" | xargs dprint fmt --allow-no-files 2>/dev/null; then
    green "PASS: formatting"
    # Re-stage formatted files
    echo "$FORMAT_FILES" | xargs git add 2>/dev/null
  else
    red "FAIL: formatting"
    failures=$((failures + 1))
  fi
fi

# Shell scripts: shfmt format
if [[ -n "$STAGED_SH" ]]; then
  if echo "$STAGED_SH" | xargs shfmt -w -i 2 -ci -bn 2>/dev/null; then
    green "PASS: shell formatting"
    echo "$STAGED_SH" | xargs git add 2>/dev/null
  else
    red "FAIL: shell formatting"
    failures=$((failures + 1))
  fi
fi

# ── Step 2: Lint staged files ────────────────────────────────
echo ""
echo "--- Step 2: Lint staged files ---"

if [[ -n "$STAGED_TS" ]]; then
  cyan "Linting TypeScript..."
  if echo "$STAGED_TS" | xargs bunx eslint --no-error-on-unmatched-pattern 2>/dev/null; then
    green "  ✓ TypeScript lint passed"
  else
    red "  ✗ TypeScript lint failed"
    failures=$((failures + 1))
  fi
fi

if [[ -n "$STAGED_CSS" ]]; then
  cyan "Linting CSS..."
  if echo "$STAGED_CSS" | xargs bunx stylelint 2>/dev/null; then
    green "  ✓ CSS lint passed"
  else
    red "  ✗ CSS lint failed"
    failures=$((failures + 1))
  fi
fi

if [[ -n "$STAGED_MD" ]]; then
  cyan "Linting Markdown..."
  if echo "$STAGED_MD" | xargs bunx markdownlint-cli2 2>/dev/null; then
    green "  ✓ Markdown lint passed"
  else
    red "  ✗ Markdown lint failed"
    failures=$((failures + 1))
  fi
fi

if [[ -n "$STAGED_HTML" ]]; then
  cyan "Checking HTML..."
  # markuplint on staged files only
  if echo "$STAGED_HTML" | xargs bunx markuplint --allow-warnings 2>/dev/null; then
    green "  ✓ HTML lint passed"
  else
    yellow "  ⚠ HTML lint warnings (non-blocking)"
  fi
fi

if [[ -n "$STAGED_SH" ]]; then
  cyan "Linting shell scripts..."
  if echo "$STAGED_SH" | xargs shellcheck -x -s bash -S error 2>/dev/null; then
    green "  ✓ Shell lint passed"
  else
    red "  ✗ Shell lint failed"
    failures=$((failures + 1))
  fi
fi

# ── Step 3: SPDX headers on staged source files ──────────────
echo ""
echo "--- Step 3: SPDX headers ---"
STAGED_SOURCE=$(echo "$STAGED_TS $STAGED_CSS $STAGED_HTML $STAGED_SH" | tr ' ' '\n' | grep -v '^$' || true)
if [[ -n "$STAGED_SOURCE" ]]; then
  # NO 2>/dev/null. The script is advisory (exit 0) unless SPDX_CHECK=1, so
  # swallowing its stderr printed "✓ SPDX headers OK" while hiding every
  # violation it had just reported — and, once the script was deleted, the
  # same green line covered a checker that could not run at all. Capture the
  # report, show it, and branch on the exit code AND the advisory marker. A
  # missing script exits non-zero, so it lands in the blocking branch.
  SPDX_OUT=$(echo "$STAGED_SOURCE" | xargs bun run scripts/check-spdx.ts 2>&1)
  if [ $? -ne 0 ]; then
    red "  ✗ SPDX checker failed to run — headers NOT verified:"
    echo "$SPDX_OUT"
    failures=$((failures + 1))
  elif printf '%s' "$SPDX_OUT" | grep -q "Non-blocking - set SPDX_CHECK=1"; then
    yellow "  ⚠ SPDX header violations (non-blocking; SPDX_CHECK=1 enforces) — report:"
    echo "$SPDX_OUT"
  else
    green "  ✓ SPDX headers OK"
  fi
fi

# ── Step 4: Check-report freshness (non-blocking) ─────────────
echo ""
echo "--- Step 4: Check-report freshness ---"
REPO_TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
REPORT_FILE="$REPO_TOP/.tmp/check-report.json"
if [[ -n "$REPO_TOP" && -f "$REPORT_FILE" ]]; then
  REPORT_HEAD="$(grep -o '"gitHead"[[:space:]]*:[[:space:]]*"[^"]*"' "$REPORT_FILE" | head -1 | sed 's/.*"gitHead"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
  CURRENT_HEAD="$(git rev-parse --short HEAD 2>/dev/null || true)"
  if [[ -n "$REPORT_HEAD" ]]; then
    if [[ "$REPORT_HEAD" != "$CURRENT_HEAD" ]]; then
      yellow "  ⚠ Check report stale: reports @ $REPORT_HEAD, current HEAD @ $CURRENT_HEAD"
      yellow "    Run 'bun run check' to refresh gate status for this tree"
    else
      green "  ✓ Check report current ($CURRENT_HEAD)"
    fi
  else
    yellow "  ⚠ Check report has no gitHead (legacy) — run 'bun run check' to refresh"
  fi
else
  yellow "  ⚠ No check report found — run 'bun run check' to generate one"
fi

# ── Final result ──────────────────────────────────────────────
echo ""
if [ "$failures" -gt 0 ]; then
  red "=== $failures check(s) failed — commit blocked ==="
  red "To commit without checks: git commit --no-verify"
  exit 1
fi

green "=== Staged files OK ==="
echo ""
echo "Tip: run 'bun run check' for full typecheck + tests"
