  "schema_proposal": {
    "version": "1.0.0-draft",
    "frontmatter_required_keys": ["id", "type", "title", "status", "priority", "effort", "epic", "created", "updated"],
    "frontmatter_optional_keys": ["owner", "labels", "dependencies", "acceptance_scenarios", "revision", "_legacy"],
    "status_enum": ["draft", "proposed", "accepted", "in_progress", "blocked", "done", "archived", "dropped"],
    "status_alias_map": {
      "🟡 Design": "draft",
      "📝 Draft": "draft",
      "Draft": "draft",
      "🟨 In Progress": "in_progress",
      "In Progress": "in_progress",
      "✅ Resolved": "done",
      "[OK] Already resolved in dev — no code change needed": "done",
      "stale-resolved": "done",
      "fixed-in-worktree": "done",
      "Done": "done",
      "⬜ Not Started": "proposed",
      "open": "proposed",
      "Open": "proposed",
      "postponed": "dropped",
      "Postponed": "dropped",
      "blocked": "blocked",
      "Blocked": "blocked"
    },
    "priority_enum": ["critical", "high", "medium", "low"],
    "priority_alias_map": {
      "P0": "critical",
      "P1": "high",
      "P2": "high",
      "P3": "medium",
      "P4": "medium",
      "P5": "low",
      "P6": "low",
      "Med": "medium",
      "Med–High": "high"
    },
    "effort_enum": ["trivial", "small", "medium", "large", "xlarge"],
    "type_enum": ["epic", "feat", "task", "bug", "idea", "test", "wire", "perf", "improve"],
    "required_sections": {
      "ticket": ["# Heading", "## Summary", "## Acceptance Scenarios", "## Related", "## Files", "## Verification"],
      "epic": ["# Heading", "## Overview", "## Acceptance Scenarios", "## Tasks", "## Migration Strategy"]
    },
    "optional_sections": {
      "ticket": ["## Open Questions"],
      "epic": ["## Open Questions", "## Goals", "## Files"]
    },
    "change_bundle_optional": {
      "path": ".plan/changes/<slug>/",
      "artifacts": ["proposal.md", "design.md", "specs/<capability>.md", "tasks.md", "carryover.md"]
    },
    "index_json_evolution": {
      "policy": "REUSE not replace",
      "preserve_keys": ["hash", "extid", "type", "title", "label", "priority", "epic", "tags", "source", "git_issue", "status"],
      "new_optional_keys": ["updated", "frontmatter", "legacy_aliases"],
      "writer_strategy": "scripts/worktree/sync.ts remains canonical writer; scripts/spec/index-build.ts reads frontmatter + delegates writes; never overwrites git_issue/hash"
    }
  },
  "tooling_proposed": {
    "cli_entry": "bun run scripts/spec/index.ts",
    "package_json_binding": "bun run scripts/spec/index.ts <subcommand>",
    "subcommands": [
      {"name": "new",      "args": ["<type>", "<slug>"], "creates": ".plan/tickets/<TYPE>-<slug>.md or .plan/epics/epic-<slug>.md; updates tickets/index.json; creates git-issue"},
      {"name": "validate", "args": ["--target <id>"], "purpose": "lint frontmatter + required sections; exit 1 on invalid"},
      {"name": "index-build", "args": [], "purpose": "rewrite .plan/tickets/index.json entries from frontmatter (delegates to scripts/worktree/sync when possible)"},
      {"name": "migrate",  "args": ["--legacy-only"], "purpose": "backfill frontmatter on legacy tickets (sets _legacy: true; preserves prose untouched)"},
      {"name": "converge", "args": ["<branch-name>"], "purpose": "diff merged branch vs spec acceptance scenarios; emit carryover.md"},
      {"name": "archive",  "args": ["<change-name>"], "purpose": "move .plan/changes/<name>/ to .plan/changes/archive/<date>-<name>/"},
      {"name": "status",   "args": [], "purpose": "human-readable summary by epic/status/priority"},
      {"name": "search",   "args": ["<query>"], "purpose": "fuzzy search across .plan/"}
    ],
    "scripts": [
      "scripts/spec/index.ts",
      "scripts/spec/validate.ts",
      "scripts/spec/index-build.ts",
      "scripts/spec/new.ts",
      "scripts/spec/migrate.ts",
      "scripts/spec/converge.ts",
      "scripts/spec/archive.ts",
      "scripts/spec/status.ts",
      "scripts/spec/search.ts",
      "scripts/spec/templates/{epic,feat,task,bug,idea,test,perf,wire,improve}.md",
      "scripts/spec/utils/{frontmatter,yaml,status,priority,aliases,walk,index-json}.ts"
    ],
    "constraints": [
      "bun-native (no Node, no Python)",
      "zero runtime dependencies",
      "idempotent on every write",
      "fail-loud with structured error",
      "preserve existing prose untouched during migrate",
      "_legacy: true on any artifact touched by migrate",
      "REUSE scripts/worktree/sync.ts for index.json writes; never replace writer"
    ]
  },
  "adoption_phases": [
    {
      "phase": "A",
      "name": "Schema + validate + index-build",
      "deliverables": ["scripts/spec/{index,validate,index-build,new,status,search}.ts", "scripts/spec/templates/", "docs/spec/spec-schema.md", "package.json binding", "scripts/check integration"],
