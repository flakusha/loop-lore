{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/server/index.ts",
    "src/tui/app.ts",
    // Migrations are discovered by filename (getMigrationFiles in
    // src/db/migrate.ts), never statically imported — declare the glob.
    "src/db/migrations/*.ts",
    // Browser bundle roots: spawned as CLI args by scripts/build-frontend.mjs
    // (`bun build ... src/frontend/<root>.ts`), never imported from src/server.
    "src/frontend/alpine-init.ts",
    "src/frontend/pages.ts",
    "src/frontend/chat-vendor.ts",
    "src/frontend/chat-list.ts",
    "src/frontend/locale-init.ts",
    "src/frontend/wasm-loader.ts",
    "src/frontend/alpine/local-engine.worker.ts",
    "src/frontend/alpine/wllama-engine.worker.ts",
    "plugins/core/*/plugin.ts",
    "plugins/core/*/index.ts",
    "plugins/community/*/plugin.ts",
    "scripts/worktree/index.mjs",
    "scripts/backup-sqlite.ts",
    "scripts/validate-backup-restore.ts",
    "scripts/check-no-shell-refs.ts",
    "scripts/check-migration-ordering.ts",
    "scripts/lib/assertions.ts",
    "scripts/lib/colors.ts"
  ],
  "project": [
    // src/** is only scanned when knip runs with --no-gitignore (see the
    // dead:code scripts in package.json): src/.gitignore contains `.` to keep
    // untracked junk out of git, which otherwise makes knip skip every src/ file.
    "src/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "plugins/**/*.ts"
  ],
  // Type-export analysis is ENABLED (per-symbol policy). Intentionally
  // public type re-exports (test factories, plugin sample surface) carry
  // /** @knipignore */ tags at their declaration instead of a global gag.
  "ignoreDependencies": [
    // Runtime/string-resolved -- used via plugin manifest paths, build scripts,
    // or dynamic imports knip can't follow (blessed TUI internals, htmx
    // extensions, html build plugin).
    "blessed-contrib",
    "htmx-ext-alpine-morph",
    "bun-plugin-html",
    "@markuplint/html-spec",
    "@markuplint/mustache-parser", // referenced by .markuplintrc.json (config), not imported in code
    "@types/dompurify",
    "@types/js-yaml",
    "@types/jszip",
    // Mermaid docs stack: resolved via docs/.vitepress/{config.mts,theme/index.ts}
    // (not in knip's entry list) + invoked by bun run mermaid:lint (shell
    // string, not import). Same class as @markuplint.
    "@mermaid-js/parser",
    "mermaid",
    "vitepress-mermaid-renderer",
    "vitepress-plugin-mermaid"
  ],
  "ignoreBinaries": [
    "abort", // worktree CLI subcommand literal in finalize-signal-safety.test.ts spawnSync; knip mistakes it for a binary
    "scancode", // license compliance gate (scripts/check-licenses.ts)
    "fossa", // license compliance gate (scripts/check-licenses.ts)
    "tail", // changelog gate (scripts/check-changelog.ts git-tag query)
    "rustup", // Rust toolchain (scripts/build-native.ts) -- external, not npm
    "rustc" // native cdylib compile (scripts/build-native.ts) -- external, not npm
  ],
  "ignore": [
    // Sample-plugin public API types
    // Dead scaffolding deliberately kept for the plugin extension
    // surface (no consumer yet). Tracked: TASK-knip-dead-code.
    "plugins/**/types.ts",

    // Native benchmarks
    // Standalone bench entrypoints (run directly, never imported) --
    // same class as scripts/worktree leftovers above.
    "tests/benchmarks/blake3.bench.ts",
    "tests/benchmarks/zstd.bench.ts",

    // EXPORTS ANALYSIS RE-ENABLED (2026-08-21)
    // False positives: symbol IS used but knip can't trace usage due to
    // dynamic/plugin/test/reexport/intra-file patterns.
    //
    // Plugin routes: loaded via register-plugins.ts manifest (dynamic registration).
    // isRollCommand/parseTextCommand: defined in engine.ts, barrel-re-exported
    // via index.ts; routes.ts:70 re-exports them; plugin is loaded dynamically
    // via manifest (knip can't trace dynamic plugin registration).
    "plugins/core/dice-roller/routes.ts",
    //
    // Test helpers barrel re-exports used via seedAll; knip can't trace
    // that the individual seeder functions are called by seedAll().
    // Tests only import seedAll, seedUsers, seedChat.
    "tests/e2e/helpers/seed.ts",
    //
    // assertNoPageErrors/isAlpineInitialized: called only within htmx-alpine.ts.
    // Tests only import the trackPageErrors singleton, not these wrappers.
    "tests/e2e/helpers/htmx-alpine.ts",
    //
    // _handleImportRequest: internal route handler called only by createTestServer's
    // route dispatcher. createTestServer IS used by all e2e tests; knip can't
    "tests/e2e/helpers/server.ts",

    // FE-BE harmonization gate: standalone CLI invoked via check-parallel.mjs
    // shell string, not import-reachable — same class as check-db-schemas.ts.
    "scripts/check-fe-be-harmonization.ts",
    // Sub-modules of the harmonization gate: statically imported only by the
    // ignored standalone CLI above, so unreachable from knip entrypoints.
    "scripts/fe-be-harmonization/**",
    // Finalize-lock child-process fixture: spawned by
    // scripts/worktree/finalize-lock-cleanup.test.ts via path (not a static
    // import knip can trace).
    "scripts/worktree/finalize-lock-fixture.ts",

    // Coverage gate script: run via check-parallel.mjs shell string
    // (bun run test:coverage && bun run scripts/check/coverage.mjs --floor=80),
    // not import-reachable — same class as check-db-schemas.ts above.
    "scripts/check/coverage.mjs",
    // Sub-modules of the coverage gate: statically imported only by the
    // ignored standalone CLI above, so unreachable from knip entrypoints —
    // same class as scripts/fe-be-harmonization/** below.
    "scripts/check/coverage/**",
    // Generated epic title lookup: produced by epic-owner-pick.ts --gen
    // (run manually, not import-wired); consumed by the epic-owner rule
    // through in-process scanEpicTitles(), never via an import edge.
    "scripts/plan/epic-titles.generated.ts",

    // Ambient window typings for the Alpine scope: consumed through the
    // tsconfig include, never imported — knip cannot see that edge.
    "src/frontend/alpine/window-types.ts",

    // GENERATED DB ARTIFACTS (`bun run db:sync-types` / `db:sync-manifest`,
    // both writing scripts/generate-db-types.ts). Each file exports one symbol
    // per table/column regardless of whether the route layer imports it today,
    // so per-symbol analysis is meaningless: the generator is the only producer
    // and it emits the full surface by construction. Excluding the files (not
    // their consumers) is the narrow form — nothing hand-written is gaged.
    "src/db/schema.ts",
    "src/db/schema-*.ts", // src/db/schema-{domain}.ts, one per domain (generate-db-types.ts:628)
    "src/db/schema-manifest.ts", // generate-schema-manifest.ts: parses migrations/ into a table manifest
    "src/validation/db-schemas.ts", // generate-db-types.ts:603 — TypeBox schema per DB table
    "src/test-utils/insert-helpers.ts", // generate-db-types.ts:479 — typed insert fn per table

    // API reference drift gate: run via check-parallel.mjs shell string
    // ("api - doc drift": bun run scripts/check/api-doc-drift.mjs), not
    // import-reachable — same class as weave-damage.mjs above.
    "scripts/check/api-doc-drift.mjs",
    // Frontend audit scripts: standalone CLI reporters (bun run scripts/...),
    // not import-reachable. Promoted from .tmp/ investigation scripts.
    "scripts/check-frontend-banned-patterns.ts",
    "scripts/check-frontend-innerhtml-xss.ts",
    "scripts/check-epic-coverage.ts",

    "tests/e2e/flows/browser/admin-dashboard-populated.browser.ts",
    "tests/e2e/flows/browser/auth-flow.browser.ts",
    "tests/e2e/flows/browser/auth-session.browser.ts",
    "tests/e2e/flows/browser/characters-flow.browser.ts",
    "tests/e2e/flows/browser/chat-flow.browser.ts",
    "tests/e2e/flows/browser/chat-send.browser.ts",
    "tests/e2e/flows/browser/chat-state.browser.ts",
    "tests/e2e/flows/browser/creation-flow.browser.ts",
    "tests/e2e/flows/browser/gallery-flow.browser.ts",
    "tests/e2e/flows/browser/group-chat-matrix.browser.ts",
    "tests/e2e/flows/browser/htmx-alpine.browser.ts",
    "tests/e2e/flows/browser/navigation.browser.ts",
    "tests/e2e/flows/browser/notifications-flow.browser.ts",
    "tests/e2e/flows/browser/nsfw-moderation-flow.browser.ts",
    "tests/e2e/flows/browser/personas-flow.browser.ts",
    "tests/e2e/flows/browser/quests-flow.browser.ts",
    "tests/e2e/flows/browser/redirection.browser.ts",
    "tests/e2e/flows/browser/register-flow.browser.ts",
    "tests/e2e/flows/browser/search-flow.browser.ts",
    "tests/e2e/flows/browser/settings-flow.browser.ts",
    "tests/e2e/flows/browser/world-invites.browser.ts",
    "tests/e2e/flows/browser/worlds-flow.browser.ts",
    "tests/e2e/flows/browser/vn-settings.browser.ts",
    "tests/e2e/flows/browser/access-correctness.browser.ts",
    // Newly added e2e browser tests; not yet wired into a static import
    // edge knip can trace (Playwright discovers by glob). Same class as
    // the 22 sibling .browser.ts entries above.
    "tests/e2e/flows/browser/admin-dashboard-empty.browser.ts",
    "tests/e2e/flows/browser/encryption-flow.browser.ts",
    // Interaction-coverage suite. Executed by the shell glob in
    // package.json `test:e2e:browser` and .github/workflows/ci.yml
    // (test-browser job) — knip cannot trace a shell glob as an import edge.
    "tests/e2e/flows/browser/harness-improvements.browser.ts",
    // Docs site mermaid render gate. Built dist served by an in-process
    // Bun.serve; not imported anywhere; Playwright discovers by glob.
    // Same class as the .browser.ts entries above.
    "tests/e2e/flows/browser/docs-mermaid.browser.ts",
    // Additional view-expansion coverage (TASK-e2e-view-expansion). Same class
    // as the .browser.ts entries above: Playwright discovers by glob, knip
    // cannot trace a shell glob as an import edge.
    "tests/e2e/flows/browser/admin-nonadmin-guard.browser.ts",
    "tests/e2e/flows/browser/character-edit-view.browser.ts",
    "tests/e2e/flows/browser/chat-list-view.browser.ts",
    "tests/e2e/flows/browser/new-chat-advanced-fields.browser.ts",
    "tests/e2e/flows/browser/i18n-locale.browser.ts",

    // Autonomy panel coverage (TASK-autonomy-config-surface). Same class
    // as the .browser.ts entries above: Playwright discovers by glob, knip
    // cannot trace a shell glob as an import edge.
    "tests/e2e/flows/browser/autonomy-panel.browser.ts",
    // Alpine hydration regression coverage. Same class as the .browser.ts
    // entries above: run-browser-tests.ts discovers by directory glob, knip
    // cannot trace a shell glob as an import edge.
    "tests/e2e/flows/browser/alpine-hydration-smoke.browser.ts",
    "tests/e2e/flows/browser/alpine-post-swap.browser.ts",
    // Chat-header notification bell coverage. Same class as the entries
    // above: run-browser-tests.ts discovers by directory glob, knip cannot
    // trace a shell glob as an import edge.
    "tests/e2e/flows/browser/notifications-bell.browser.ts",
  ]
}
