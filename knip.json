{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // The two app roots. knip hints "Remove redundant entry pattern" for them
    // (it dedupes them against `project`), but that is WRONG here: deleting them
    // makes pass 1 of `bun run dead:code` report `blessed` + `@types/blessed`
    // as unused, because src/ is invisible there and these entries are the only
    // thing that seeds the src/tui graph. Measured, then reverted.
    "src/server/index.ts",
    "src/tui/app.ts",
    // Migrations are discovered by filename (getMigrationFiles in
    // src/db/migrate.ts), never statically imported — declare the glob.
    "src/db/migrations/*.ts",
    // Browser bundle roots: spawned as CLI args by scripts/build-frontend.mjs
    // (`bun build ... src/frontend/<root>.ts`), never imported from src/server.
    "src/frontend/alpine-init.ts",
    "src/frontend/pages.ts",
    "src/frontend/chat-vendor.ts",
    "src/frontend/chat-list.ts",
    "src/frontend/locale-init.ts",
    "src/frontend/egui-bridge.ts",
    "src/frontend/wasm-loader.ts",
    "src/frontend/alpine/local-engine.worker.ts",
    "src/frontend/alpine/wllama-engine.worker.ts",
    // Plugin roots, discovered at runtime by the manifest loader
    // src/plugins/loader.ts:40-44 (PLUGIN_DIRS: core -> community -> local),
    // which builds `join(pluginDir, "plugin.ts")` and dynamic-imports it at
    // loader.ts:149-156 — a string path knip cannot follow.
    "plugins/core/*/plugin.ts",
    "plugins/core/*/index.ts",
    "plugins/community/*/plugin.ts",
    "scripts/backup-sqlite.ts",
    "scripts/validate-backup-restore.ts",
    "scripts/check-no-shell-refs.ts",
    "scripts/check-migration-ordering.ts",
    "bin/lolo.ts"
  ],
  "project": [
    // src/ is INVISIBLE to a gitignore-respecting knip run: src/.gitignore is a
    // blanket `.` (it keeps untracked scratch out of git) and knip honours
    // gitignore, so plain `knip` resolves ZERO src files and reports
    // `src/**/*.ts  Refine project pattern (no matches)` on every run.
    // src/.gitignore stays exactly as it is; the gate compensates instead —
    // `bun run dead:code` runs knip TWICE:
    //   pass 1  plain knip (gitignore respected) — files/exports/types AND
    //           dependencies for scripts/, tests/, plugins/. src/ is absent here
    //           by construction, which is why the src-only deps below still have
    //           to sit in ignoreDependencies.
    //   pass 2  `--no-gitignore --include dependencies,unlisted,binaries` —
    //           dependency analysis over EVERYTHING, src/ included. This is the
    //           pass that makes src/ coverage real: a dependency imported only
    //           from src/ is traced, and one that is genuinely unused fails the
    //           BLOCKING gate instead of hiding behind the ignore list.
    //           (Pass 2 is scoped because `knip --no-gitignore` on its own is
    //           not an option: src export analysis is unreviewable symbol-level
    //           debt owned by the cleanup tickets.)
    // src/ files and src/ exports are deliberately out of the blocking pass:
    // `files` is the advisory `dead - code (src files)` gate (src carries a
    // known dead-file backlog owned by the cleanup tickets).
    "src/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "plugins/**/*.ts"
  ],
  // Type-export analysis is ENABLED (per-symbol policy). Intentionally
  // public type re-exports (test factories, plugin sample surface) carry
  // /** @knipignore */ tags at their declaration instead of a global gag.
  "ignoreDependencies": [
    // Every entry below is unused *as seen by pass 1* (plain knip). For the
    // src-only ones that is expected: pass 2 of `bun run dead:code` traces the
    // real src/ import edges. The `Remove from ignoreDependencies` hints pass 2
    // emits for them are the proof, not a request.
    //
    // NO IMPORT EDGE ANYWHERE (swept across src/, tests/, scripts/, plugins/,
    // configs/, bunfig.toml and .github/workflows): these three are unreferenced
    // runtime dependencies, not dynamic imports. Retained rather than removed —
    // deleting a dependency is a separate decision from a knip-config edit, and
    // no importer can honestly be cited for them.
    "blessed-contrib", // AGENTS.md:162 + docs/spec/terminal-ui.md:8 name it as the TUI stack; every src/tui/* import is plain "blessed"
    "htmx-ext-alpine-morph", // src/frontend/vendor.ts registers htmx-ext-sse + @alpinejs/morph directly; this extension has no registration site
    "bun-plugin-html", // Bun html-bundler plugin; no Bun.plugin()/preload registration in bunfig.toml or scripts/build-frontend.mjs
    //
    // SRC-ONLY IMPORTERS (each cited below). Real import edges under src/ that
    // the gitignore-respecting pass 1 cannot see; pass 2 traces them.
    // Imported by src/content/minify.ts:4-6 (frontend asset minifier pipeline).
    "clean-css",
    "html-minifier-terser",
    "terser",
    "@types/clean-css", // ambient types for clean-css above
    "@types/html-minifier-terser",
    // Imported by src/characters/charx.ts:11, src/routes/assets.ts:34 and
    // src/routes/export-shared/*.ts.
    "jszip",
    // Imported by src/profanity/service.ts (TextCensor / RegExpMatcher NSFW gate).
    "obscenity",
    // Imported by src/native/fallback/blake3.ts as the SUBPATH
    // "@noble/hashes/blake3.js", which knip does not map back to the package.
    "@noble/hashes",
    // Imported by src/cli/parser.ts as SUBPATHs ("@optique/core/parser",
    // "@optique/core/valueparser") plus the bare roots.
    "@optique/core",
    "@optique/run",
    // Imported by src/assets/service/thumbnail.ts (sharp image transform).
    "sharp",
    // Imported by src/generation/providers/retry.ts + src/llm/concurrency-limiter.ts
    // (Effect/Schedule/Semaphore); provider subdirs are reached through a
    // dynamic "./anthropic" / "./ollama-native" index chain knip does not follow.
    "effect",
    // Imported by src/test-utils/schema-arbitrary*.ts (TypeBox -> Arbitrary
    // mapper); the property tests consuming it live under src/ too.
    "fast-check",
    // Imported by src/routes/v1/openapi.ts; the OpenAPI document is attached
    // to the app via Elysia's plugin chain, not a static edge from src/server.
    "@elysia/openapi",
    "@markuplint/html-spec", // referenced by .markuplintrc.json (config), not imported in code
    "@markuplint/mustache-parser",
    // Type-only companions of packages imported above; no runtime import edge
    // exists for them, which is exactly why they need an ignore.
    "@types/dompurify", // dompurify is imported by src/frontend/chat-vendor.ts:9
    "@types/js-yaml", // js-yaml is imported by src/admin/config.ts:12, src/characters/parser.ts:13, src/characters/exporters/yaml.ts:22, ...
    "@types/jszip", // jszip is imported by src/characters/charx.ts:11, src/routes/assets.ts:34, ...
    // Mermaid docs stack: resolved via docs/.vitepress/{config.mts,theme/index.ts}
    // (not in knip's entry list) + invoked by bun run mermaid:lint (shell
    // string, not import). Same class as @markuplint.
    "@mermaid-js/parser",
    "mermaid",
    "vitepress-mermaid-renderer",
    "vitepress-plugin-mermaid",
    // jscpd clone scanner: run as a binary spawned by name from
    // scripts/check/jscpd-scan.mjs (Bun.spawnSync(["bunx", "jscpd", ...])),
    // never imported. The package.json `jscpd`/`jscpd:full` scripts and the
    // `jscpd ratchet` gate all reach it through that one module.
    "jscpd"
  ],
  "ignoreBinaries": [
    "scancode", // license compliance gate (scripts/check-licenses.ts)
    "fossa", // license compliance gate (scripts/check-licenses.ts)
    "tail", // changelog gate (scripts/check-changelog.ts git-tag query)
    "rustup", // Rust toolchain (scripts/build-native.ts) -- external, not npm
    "rustc", // native cdylib compile (scripts/build-native.ts) -- external, not npm
    "wasm-bindgen" // egui wasm glue (scripts/build-egui-wasm.ts) -- cargo-installed CLI, not npm
  ],
  "ignore": [
    // Build-time CLIs spawned as shell strings by scripts/build-frontend.mjs
    // (`await $`bun run src/build/copy-icons.ts`` / `... src/build/compress.ts`),
    // never statically imported — knip cannot follow a Bun shell template.
    "src/build/copy-icons.ts",
    "src/build/compress.ts",
    // UNWIRED, owned elsewhere — NOT dead (TASK-delete-or-wire-dead-modules-
    // flagged-in-glm-review-sweep triaged these; each needs a product call, not
    // a deletion):
    //   nsfw-context.ts -> owned by wire-deadcode
    //   activitypub-keys.ts -> prerequisite for FEAT-activitypub-federation
    //     (BUG-activitypub-actor-keys-table... says keep until that FEAT lands)
    //   touch.ts, keynav-help.ts, mobile-composer.ts -> open WIRE tickets under
    //     epic-frontend-keynav-mobile; keynav-help/mobile-composer already have
    //     live HTML partials binding x-data="keynavHelp()"/"mobileComposer()"
    //   transport/index.ts + transport/test/harness.ts -> CONTESTED:
    //     epic-transport-expansion.md lists both as Built deliverables
    "src/assistant/prompt/sections/nsfw-context.ts",
    "src/crypto/activitypub-keys.ts",
    "src/frontend/alpine/keynav-help.ts",
    "src/frontend/alpine/mobile-composer.ts",
    "src/frontend/touch.ts",
    "src/transport/index.ts",
    "src/transport/test/harness.ts",

    // Sample-plugin public API types
    // Dead scaffolding deliberately kept for the plugin extension
    // surface (no consumer yet). Tracked: TASK-knip-dead-code.
    "plugins/**/types.ts",

    // Native benchmarks
    // Standalone bench entrypoints (run directly, never imported) --
    // same class as the standalone gate CLIs listed further down.
    "tests/benchmarks/blake3.bench.ts",
    "tests/benchmarks/zstd.bench.ts",

    // EXPORTS ANALYSIS RE-ENABLED (2026-08-21)
    // False positives: symbol IS used but knip can't trace usage due to
    // dynamic/plugin/test/reexport/intra-file patterns.
    //
    // Plugin routes: loaded via register-plugins.ts manifest (dynamic registration).
    // isRollCommand/parseTextCommand: defined in engine.ts, barrel-re-exported
    // via index.ts; routes.ts:70 re-exports them; plugin is loaded dynamically
    // via manifest (knip can't trace dynamic plugin registration).
    "plugins/core/dice-roller/routes.ts",
    //
    // Test helpers barrel re-exports used via seedAll; knip can't trace
    // that the individual seeder functions are called by seedAll().
    // Tests only import seedAll, seedUsers, seedChat.
    "tests/e2e/helpers/seed.ts",
    //
    // assertNoPageErrors/isAlpineInitialized: called only within htmx-alpine.ts.
    // Tests only import the trackPageErrors singleton, not these wrappers.
    "tests/e2e/helpers/htmx-alpine.ts",
    //
    // _handleImportRequest: internal route handler called only by createTestServer's
    // route dispatcher. createTestServer IS used by all e2e tests; knip can't
    "tests/e2e/helpers/server.ts",

    // FE-BE harmonization gate: standalone CLI invoked via check-parallel.mjs
    // shell string, not import-reachable — same class as check-db-schemas.ts.
    "scripts/check-fe-be-harmonization.ts",
    // Sub-modules of the harmonization gate: statically imported only by the
    // ignored standalone CLI above, so unreachable from knip entrypoints.
    "scripts/fe-be-harmonization/**",

    // Coverage gate script: run via check-parallel.mjs shell string
    // (bun run test:coverage && bun run scripts/check/coverage.mjs --floor=80),
    // not import-reachable — same class as check-db-schemas.ts above.
    "scripts/check/coverage.mjs",
    // Sub-modules of the coverage gate: statically imported only by the
    // ignored standalone CLI above, so unreachable from knip entrypoints —
    // same class as scripts/fe-be-harmonization/** below. knip hints "Remove
    // from ignore" here, but that is wrong for this repo: dropping it makes
    // `bun run dead:code:src` report diff-mode.mjs / lcov.mjs / waivers.mjs as
    // unused files. Measured, then reverted.
    "scripts/check/coverage/**",

    // The six src/ ignore entries below exist for the --no-gitignore passes
    // only. A plain knip run resolves zero src/ files and therefore reports
    // them as "Remove from ignore"; knip emits no such hint under
    // --no-gitignore, because there the files are visible and genuinely need
    // excluding.

    // Ambient window typings for the Alpine scope: consumed through the
    // tsconfig include, never imported — knip cannot see that edge.
    "src/frontend/alpine/window-types.ts",

    // GENERATED DB ARTIFACTS (`bun run db:sync-types` / `db:sync-manifest`,
    // both writing scripts/generate-db-types.ts). Each file exports one symbol
    // per table/column regardless of whether the route layer imports it today,
    // so per-symbol analysis is meaningless: the generator is the only producer
    // and it emits the full surface by construction. Excluding the files (not
    // their consumers) is the narrow form — nothing hand-written is gaged.
    "src/db/schema.ts",
    // src/db/schema-{domain}.ts, one per domain (generate-db-types.ts:323). The
    // trailing `!` negation keeps the HAND-WRITTEN schema-sync.test.ts out: the
    // generator writes `schema-${domain}.ts`, never a `.test.ts`, but the bare
    // `schema-*.ts` glob swallowed the test and kept it unanalysed.
    "src/db/schema-*.ts",
    "!src/db/schema-sync.test.ts",
    "src/db/schema-manifest.ts", // generate-schema-manifest.ts: parses migrations/ into a table manifest
    "src/validation/db-schemas.ts", // generate-db-types.ts:603 — TypeBox schema per DB table
    "src/test-utils/insert-helpers.ts", // generate-db-types.ts:479 — typed insert fn per table

    // API reference drift gate: run via check-parallel.mjs shell string
    // ("api - doc drift": bun run scripts/check/api-doc-drift.mjs), not
    // import-reachable — same class as weave-damage.mjs above.
    "scripts/check/api-doc-drift.mjs",
    // Frontend audit scripts: standalone CLI reporters (bun run scripts/...),
    // not import-reachable. Promoted from .tmp/ investigation scripts.
    "scripts/check-frontend-banned-patterns.ts",
    "scripts/check-frontend-innerhtml-xss.ts",
    "scripts/check-epic-coverage.ts",

    "tests/e2e/flows/browser/admin-dashboard-populated.browser.ts",
    "tests/e2e/flows/browser/auth-flow.browser.ts",
    "tests/e2e/flows/browser/auth-session.browser.ts",
    "tests/e2e/flows/browser/characters-flow.browser.ts",
    "tests/e2e/flows/browser/chat-flow.browser.ts",
    "tests/e2e/flows/browser/chat-send.browser.ts",
    "tests/e2e/flows/browser/chat-state.browser.ts",
    "tests/e2e/flows/browser/creation-flow.browser.ts",
    "tests/e2e/flows/browser/gallery-flow.browser.ts",
    "tests/e2e/flows/browser/group-chat-matrix.browser.ts",
    "tests/e2e/flows/browser/htmx-alpine.browser.ts",
    "tests/e2e/flows/browser/navigation.browser.ts",
    "tests/e2e/flows/browser/notifications-flow.browser.ts",
    "tests/e2e/flows/browser/nsfw-moderation-flow.browser.ts",
    "tests/e2e/flows/browser/personas-flow.browser.ts",
    "tests/e2e/flows/browser/quests-flow.browser.ts",
    "tests/e2e/flows/browser/redirection.browser.ts",
    "tests/e2e/flows/browser/register-flow.browser.ts",
    "tests/e2e/flows/browser/search-flow.browser.ts",
    "tests/e2e/flows/browser/settings-flow.browser.ts",
    "tests/e2e/flows/browser/world-invites.browser.ts",
    "tests/e2e/flows/browser/worlds-flow.browser.ts",
    "tests/e2e/flows/browser/vn-settings.browser.ts",
    "tests/e2e/flows/browser/access-correctness.browser.ts",
    // Newly added e2e browser tests; not yet wired into a static import
    // edge knip can trace (Playwright discovers by glob). Same class as
    // the 22 sibling .browser.ts entries above.
    "tests/e2e/flows/browser/admin-dashboard-empty.browser.ts",
    "tests/e2e/flows/browser/encryption-flow.browser.ts",
    // Interaction-coverage suite. Executed by the shell glob in
    // package.json `test:e2e:browser` and .github/workflows/ci.yml
    // (test-browser job) — knip cannot trace a shell glob as an import edge.
    "tests/e2e/flows/browser/harness-improvements.browser.ts",
    // Docs site mermaid render gate. Built dist served by an in-process
    // Bun.serve; not imported anywhere; Playwright discovers by glob.
    // Same class as the .browser.ts entries above.
    "tests/e2e/flows/browser/docs-mermaid.browser.ts",
    // Additional view-expansion coverage (TASK-e2e-view-expansion). Same class
    // as the .browser.ts entries above: Playwright discovers by glob, knip
    // cannot trace a shell glob as an import edge.
    "tests/e2e/flows/browser/admin-nonadmin-guard.browser.ts",
    // Playwright discovers by glob, knip cannot trace a glob as an import edge.
    "tests/e2e/flows/browser/age-gate-guard.browser.ts",
    "tests/e2e/flows/browser/character-edit-view.browser.ts",
    "tests/e2e/flows/browser/chat-list-view.browser.ts",
    "tests/e2e/flows/browser/new-chat-advanced-fields.browser.ts",
    "tests/e2e/flows/browser/i18n-locale.browser.ts",

    // Autonomy panel coverage (TASK-autonomy-config-surface). Same class
    // as the .browser.ts entries above: Playwright discovers by glob, knip
    // cannot trace a shell glob as an import edge.
    "tests/e2e/flows/browser/autonomy-panel.browser.ts",
    // Alpine hydration regression coverage. Same class as the .browser.ts
    // entries above: run-browser-tests.ts discovers by directory glob, knip
    // cannot trace a shell glob as an import edge.
    "tests/e2e/flows/browser/alpine-hydration-smoke.browser.ts",
    "tests/e2e/flows/browser/alpine-post-swap.browser.ts",
    // Chat-header notification bell coverage. Same class as the entries
    // above: run-browser-tests.ts discovers by directory glob, knip cannot
    // trace a shell glob as an import edge.
    "tests/e2e/flows/browser/notifications-bell.browser.ts",
    // htmx -> egui -> htmx transfer round-trip (TASK-htmx-to-egui-to-htmx-transfers-with-browser-side-context-sto).
    // Same class as the entries above: run-browser-tests.ts discovers by directory glob, knip
    // cannot trace a shell glob as an import edge.
    "tests/e2e/flows/browser/egui-transfer.browser.ts",
    // Chat interaction coverage (B1/B2/B4/B5/B7). Same class as the entries
    // above: run-browser-tests.ts discovers by directory glob, knip cannot
    // trace a shell glob as an import edge.
    "tests/e2e/flows/browser/chat-branches.browser.ts",
    "tests/e2e/flows/browser/chat-composer-interactions.browser.ts",
    "tests/e2e/flows/browser/chat-memory-panel.browser.ts",
    "tests/e2e/flows/browser/chat-message-actions.browser.ts",
    "tests/e2e/flows/browser/chat-settings-save.browser.ts",
    // Interaction-surface coverage (blog/config, character panel, chat batch,
    // settings data actions). Same class as the entries above:
    // run-browser-tests.ts discovers by directory glob, knip cannot trace a
    // shell glob as an import edge.
    "tests/e2e/flows/browser/blog-config-interactions.browser.ts",
    "tests/e2e/flows/browser/character-panel-saves.browser.ts",
    "tests/e2e/flows/browser/chat-batch-ops.browser.ts",
    "tests/e2e/flows/browser/settings-data-actions.browser.ts",
    // Standalone CLI entry points, invoked via `bun run` shell strings
    // (package.json scripts), never statically imported — knip cannot trace
    // a shell-string invocation as an import edge. Same class as the
    // scripts/check/*.mjs entries above.
    "src/config/generate-domain-schemas.ts",
    "src/scripts/smoke-app.ts",
  ]
}
